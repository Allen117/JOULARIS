<Project>
  <!--
    產品版號唯一真相來源（規則見 CLAUDE.md §版本號規則，格式 YY.A.B）。
    MSBuild 自動套到所有 csproj：AssemblyVersion / FileVersion / InformationalVersion。
    帶出處：Web footer（AssemblyInformationalVersion）、exe 檔案屬性、
    BuildRelease.ps1 讀此檔 → Release 包名 + Install.bat 的 Windows 服務描述。
  -->
  <PropertyGroup>
    <Version>26.19.5</Version>
    <!-- .NET 8 SDK 預設把 git commit hash 接在 InformationalVersion 後（26.1.0+abc123），關掉 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>JOULARIS</Product>
    <Company>工研院</Company>
  </PropertyGroup>
</Project>
