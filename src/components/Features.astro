  {
    icon: '<path d="M4 6h7.2M16.8 6H20M9.8 12H20M4 18h9.2M18.8 18H20"/><circle cx="14" cy="6" r="2.4"/><circle cx="7" cy="12" r="2.4"/><circle cx="16" cy="18" r="2.4"/>',
    title: '自動化控制',
    desc: '排程與演算法依現場條件自動啟停、調節設備，值班人員不用整天盯著畫面手動操作。',
  },
  {
    icon: '<path d="M3.5 18.5l4.3-5 3.4 2.9 4.4-5.7"/><path d="M18.6 3.2l.9 2.7 2.7.9-2.7.9-.9 2.7-.9-2.7-2.7-.9 2.7-.9z"/><path stroke-width="2.4" d="M13.9 5.2h0"/>',
    title: '節能分析報告',
    desc: 'AI 分析歷史用能模式，指出浪費集中的設備與時段，並提出具體的改善建議。',
  },
  {
    icon: '<rect x="5.5" y="3.5" width="13" height="17" rx="2"/><path d="M9 7.5h6"/><path stroke-width="2.4" d="M9 12.5h0M12 12.5h0M15 12.5h0M9 16.5h0M12 16.5h0M15 16.5h0"/>',
    title: '費用自動計算',
    desc: '電費依時間電價（TOU）與假日規則逐期自動結算，水費、氣費也一併計算，免去人工對帳。',
  },
  {
    icon: '<path d="M4.5 16.5a7.5 7.5 0 0 1 15 0"/><path d="M17.3 11.2l-1.3 1.3"/><path d="M12 16.5L9.3 10.4"/><path stroke-width="2.4" d="M12 16.5h0"/>',
    title: '需量即時追蹤',
    desc: '持續監看即時需量，逼近契約容量上限就發出警報，避免超約附加費。',
  },
  {
    icon: '<circle cx="5.5" cy="5" r="2.1"/><circle cx="5.5" cy="12" r="2.1"/><circle cx="5.5" cy="19" r="2.1"/><circle cx="18" cy="12" r="2.9"/><path d="M7.6 5.6c3.6.9 4.6 4.1 7.3 5.4M7.7 12h7.3M7.6 18.4c3.6-.9 4.6-4.1 7.3-5.4"/>',
    title: '多來源即時採集',
    desc: '支援 Modbus、OPC UA 與資料庫介接，直接讀取既有電表與設備的數據，不需要更換硬體。',
  },
  {
    icon: '<path d="M6 7.4c1.5 1.9 2.3 3.2 2.3 4.5a2.3 2.3 0 1 1-4.6 0C3.7 10.6 4.5 9.3 6 7.4z"/><path d="M13.4 3.5l-3.7 8.9h2.9l-1.8 8.1 4.9-10h-3l2.4-7z"/><path d="M18.9 7.4c.2 1.1.7 1.8 1.3 2.5.6.8 1 1.5 1 2.4a2.6 2.6 0 1 1-5.2 0c0-.7.2-1.3.6-1.8.3.4.7.7 1.2.8-.3-1.4 0-2.6 1.1-3.9z"/>',
    title: '電、水、氣三表整合',
    desc: '三種能源的即時用量與歷史趨勢集中在同一套系統，不用分別登入三套系統查數據。',
  },
  {
    icon: '<path d="M18 9.5a6 6 0 0 0-12 0c0 5.6-2.3 6.8-2.3 6.8h16.6S18 15.1 18 9.5"/><path d="M10.4 19.6a1.9 1.9 0 0 0 3.2 0"/><path d="M18.8 3.8a6.6 6.6 0 0 1 1.7 3M5.2 3.8a6.6 6.6 0 0 0-1.7 3"/>',
    title: '異常警報通知',
    desc: '異常發生時透過 LINE、Email 與簡訊即時通知；警報規則修改後立即生效，不需重啟系統。',
  },
  {
    icon: '<path d="M14 3.5H7.5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V8z"/><path d="M14 3.5V8h4.5"/><path d="M8.5 16l2.3-2.6 1.7 1.5 2.6-3.1"/>',
    title: '能源報表與日報',
    desc: '每日自動寄送能源概況 Email，包含當月累計趨勢與異常摘要；用電、用水、用氣報表也能定期產出。',
  },
];
---

<section class="section" id="features">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Features</span>
      <h2>產品特色</h2>
      <p>涵蓋現場數據採集、監控警報、費用計算到報表產出。</p>
    </div>
    <div class="grid grid-4">
      {
        features.map((f) => (
          <div class="card feature">
            <svg
              class="feature-icon"
              width="30"
              height="30"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={f.icon}
            />
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .feature h3 {
    font-size: 1.1rem;
    margin: 12px 0 8px;
  }

  .feature p {
    font-size: 0.95rem;
    margin: 0;
  }

  .feature-icon {
    display: block;
    color: var(--c-green-deep);
  }
</style>
