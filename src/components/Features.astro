---
// 產品能力：三個核心能力搭配實際畫面特寫，其餘能力收成短清單
// 原「為什麼選 JOULARIS」的穩定性與擴充性併入此處與導入流程
import ShotCrop from './ShotCrop.astro';
import emsDashboard from '../assets/ems-dashboard.png';
import logicflowHvac from '../assets/logicflow-hvac-v5.png';
import enpiReport from '../assets/enpi-report.png';

const core = [
  {
    title: '需量快超約之前，先通知你',
    desc: '持續監看即時需量，逼近契約容量上限就發出警報，避免超約附加費。電費依時間電價（TOU）與假日規則逐期自動結算，水費、氣費一併計算，不用再人工對帳。',
    src: emsDashboard,
    box: [14, 257, 644, 318] as [number, number, number, number],
    small: true,
    alt: '今日即時需量畫面：目前 825 kW，今日最高需量 918.4 kW（11:20）',
    caption: '今日即時需量：目前值與今日最高需量隨時看得到',
  },
  {
    title: '設備跟著現場條件自己調整',
    desc: '依室內外溫度、冰水主機用電等即時數據，自動調整冰水泵與冷卻水泵的變頻頻率，設備啟停交給排程。控制邏輯用流程圖拖拉設定，值班人員不用整天盯著畫面手動操作。',
    src: logicflowHvac,
    box: [0, 67, 2000, 1183] as [number, number, number, number],
    alt: '空調最佳化流程圖：室內外溫度與用電數據輸入，輸出冰水泵 46.5 Hz、冷卻水泵 42 Hz',
    caption: '空調最佳化流程：溫度與用電進，泵浦頻率出',
  },
  {
    title: 'ISO 50001 要的數據，系統自己彙整',
    desc: '對應 ISO 50001 能源管理系統要求，能源基線、績效指標（EnPI）與查核紀錄都由系統彙整，各迴路用電也能直接和去年同期比較。稽核或政府能源申報前，不用再翻資料拼報表。',
    src: enpiReport,
    base: [1499, 949] as [number, number],
    box: [0, 46, 1499, 903] as [number, number, number, number],
    alt: 'ISO 50001 節能量報告：逐月實際能耗與基線預測的長條圖，以及累計節能量曲線',
    caption: '節能量報告：實際用電對照基線預測，累計節能量逐月累加',
  },
];

const more = [
  {
    title: '電、水、氣三表整合',
    desc: '三種能源的即時用量與歷史趨勢放在同一套系統，不用分別登入查數據。',
  },
  {
    title: '異常即時通知',
    desc: '透過 LINE、Email 與簡訊通知指定人員，警報規則修改後立即生效。',
  },
  {
    title: '每日能源日報',
    desc: '每天寄出能源概況 Email，附當月累計趨勢與異常摘要。',
  },
  {
    title: '7×24 穩定運轉',
    desc: '背景服務長期運轉，連線中斷會自動重連，資料不會漏接。',
  },
];
---

<section class="section" id="features">
  <div class="container">
    <div class="section-head">
      <h2>每天幫你盯著的三件事</h2>
      <p>下面都是系統的實際畫面。</p>
    </div>

    <div class="core-list">
      {
        core.map((c, i) => (
          <article class:list={['core', { flip: i % 2 === 1 }]}>
            <div class="core-copy">
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </div>
            <figure class:list={['core-shot', { small: c.small }]}>
              <ShotCrop src={c.src} base={c.base} box={c.box} alt={c.alt} />
              <figcaption>{c.caption}</figcaption>
            </figure>
          </article>
        ))
      }
    </div>

    <div class="more">
      <h3 class="more-head">其他也都在裡面</h3>
      <dl class="more-list">
        {
          more.map((m) => (
            <div class="more-item">
              <dt>{m.title}</dt>
              <dd>{m.desc}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <p class="inline-cta">
      想看這些畫面接上你的電表會是什麼樣子？<a href="#contact">預約產品展示</a>
    </p>
  </div>
</section>

<style>
  .core-list {
    display: grid;
    gap: 88px;
  }

  .core {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 56px;
    align-items: center;
  }

  .core.flip {
    grid-template-columns: 7fr 5fr;
  }

  .core.flip .core-copy {
    order: 2;
  }

  .core-copy h3 {
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    line-height: 1.35;
    margin-bottom: 0.6em;
    word-break: keep-all;
  }

  .core-copy p {
    margin: 0;
    max-width: 34em;
  }

  .core-shot {
    margin: 0;
  }

  .core-shot.small {
    width: 72%;
    justify-self: center;
  }

  .core-shot :global(.shot-crop) {
    box-shadow: 0 6px 16px rgb(16 46 40 / 0.1);
  }

  .core-shot figcaption {
    margin-top: 12px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-3);
  }

  /* ---- 其他能力：不用卡片，以細線分隔的清單呈現 ---- */

  .more {
    margin-top: 96px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 40px;
  }

  .more-head {
    font-size: 1.1rem;
    margin: 0;
  }

  .more-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 40px;
    margin: 0;
  }

  .more-item dt {
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .more-item dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  @media (max-width: 860px) {
    .core-list {
      gap: 56px;
    }

    .core,
    .core.flip {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .core.flip .core-copy {
      order: 0;
    }

    .core-shot.small {
      width: 100%;
    }

    .more {
      margin-top: 64px;
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .more-list {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
