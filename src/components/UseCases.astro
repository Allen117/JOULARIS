---
// 應用場景：左側標題、右側以細線分隔的清單，不用卡片
const cases = [
  {
    title: '商辦、廠房、校園的日常能源管理',
    desc: '空調與能源監控集中在一套系統，設備異常即時告警，管理團隊能在小問題擴大之前先處理。',
  },
  {
    title: '用電大戶的需量與電費控制',
    desc: '逐期核算時間電價（TOU）並掌握尖峰用電，評估把負載移到離峰時段的空間，降低電費支出。',
  },
  {
    title: '能源申報與節能減碳追蹤',
    desc: '系統累積的報表數據，可以直接用於政府能源申報、ESG 揭露與節能績效追蹤。',
  },
];
---

<section class="section section-alt" id="use-cases">
  <div class="container uc-grid">
    <div class="uc-head">
      <h2>適用場景</h2>
      <p>三種常見的導入情境。</p>
    </div>
    <ul class="uc-list">
      {
        cases.map((c) => (
          <li>
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .uc-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 56px;
  }

  .uc-head h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  }

  .uc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .uc-list li {
    padding: 24px 0;
    border-top: 1px solid var(--border);
  }

  .uc-list li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .uc-list h3 {
    font-size: 1.1rem;
    margin-bottom: 6px;
  }

  .uc-list p {
    margin: 0;
    font-size: 0.97rem;
  }

  @media (max-width: 760px) {
    .uc-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
