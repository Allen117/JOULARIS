---
// 產品截圖局部特寫：從整張截圖裁出一個區塊放大顯示
// box 以 base 座標描述裁切範圍 [x, y, w, h]；base 預設 2000×1250（2520×1575 原圖的等比縮小）
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  box: [number, number, number, number];
  base?: [number, number];
  eager?: boolean;
  class?: string;
}

const { src, alt, box, base = [2000, 1250], eager = false, class: className } = Astro.props;
const [x, y, w, h] = box;
const [BASE_W] = base;
const scale = BASE_W / w;
// 不產生比原圖還寬的版本
const widths = [...new Set([1280, 1920, 2520].filter((n) => n < src.width).concat(src.width))];

const frameStyle = `aspect-ratio: ${w} / ${h};`;
const imgStyle = [
  `width: ${(scale * 100).toFixed(3)}%`,
  `left: ${((-x / w) * 100).toFixed(3)}%`,
  `top: ${((-y / h) * 100).toFixed(3)}%`,
].join('; ');

// 顯示寬度是容器的 scale 倍，響應式尺寸跟著放大
const vwDesktop = Math.min(Math.round(scale * 55), 300);
const vwMobile = Math.min(Math.round(scale * 100), 400);
---

<div class:list={['shot-crop', className]} style={frameStyle}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={`(max-width: 860px) ${vwMobile}vw, ${vwDesktop}vw`}
    format="webp"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    style={imgStyle}
  />
</div>

<style>
  .shot-crop {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: #fff;
  }

  .shot-crop img {
    position: absolute;
    max-width: none;
    height: auto;
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    .shot-crop img {
      filter: brightness(0.9);
    }
  }
</style>
