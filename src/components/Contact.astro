---
// 聯絡我們：純靜態，只列 Email（不接第三方表單）
const contact = {
  company: 'JOULARIS 團隊',
  email: 'Chen.Allen@itri.org.tw',
};
---

<section class="section section-alt" id="contact">
  <div class="container contact-wrap">
    <span class="eyebrow">Contact</span>
    <h2>聯絡我們</h2>
    <p>想了解 JOULARIS 如何為您的廠區找到節能方向？歡迎與我們聯繫，安排產品展示。</p>
    <div class="contact-cards">
      <a class="card contact-card" href={`mailto:${contact.email}`}>
        <span class="contact-icon">✉️</span>
        <span class="contact-label">Email</span>
        <span class="contact-value">{contact.email}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-wrap {
    text-align: center;
    max-width: 720px;
  }

  .contact-cards {
    display: grid;
    grid-template-columns: 1fr;
    max-width: 360px;
    margin: 36px auto 0;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: center;
    transition: transform 0.15s ease;
  }

  .contact-card:hover {
    transform: translateY(-3px);
  }

  .contact-icon {
    font-size: 1.6rem;
  }

  .contact-label {
    font-size: 0.85rem;
    color: var(--ink-3);
  }

  .contact-value {
    font-weight: 700;
    color: var(--ink);
    font-size: 1.05rem;
  }

</style>
