---
// 技術架構：給系統整合商（SI）與資訊部門看的規格總覽
// 內容整理自產品實際架構：後端 Engine 背景服務 + 前端 Web 儀表板
// null 表示該側不適用，畫面上以「—」呈現
const rows = [
  {
    cat: '資料採集',
    engine: 'Modbus TCP／OPC UA 輪詢採集，支援外部資料庫介接',
    web: null,
  },
  {
    cat: '資料傳輸',
    engine: 'MQTT 即時發布（QoS1、Retain）',
    web: 'MQTT 訂閱，資料串流更新',
  },
  {
    cat: '資料儲存',
    engine: '即時值與歷史資料寫入 SQL Server 保存',
    web: null,
  },
  {
    cat: '即時監控',
    engine: null,
    web: '設備樹狀導覽、即時值與通訊品質監控',
  },
  {
    cat: '歷史趨勢',
    engine: null,
    web: '歷史趨勢曲線與 Min／Max／Avg 統計分析',
  },
  {
    cat: '警報監控',
    engine: '規則引擎即時比對量測值，自動觸發警報事件',
    web: '警報規則組態與事件日誌查詢',
  },
  {
    cat: '邏輯流程',
    engine: '流程圖引擎週期性評估，條件成立即送出控制命令',
    web: '拖曳式流程圖設計畫布',
  },
  {
    cat: '排程管理',
    engine: '排程引擎自動執行設備的啟動與停止',
    web: '週間／交替模式排程組態',
  },
  {
    cat: '演算法',
    engine: 'C#（Roslyn 動態編譯）與 Python FastAPI 雙引擎',
    web: '自動掃描可用的演算法模組，供流程與排程呼叫執行',
  },
  {
    cat: '畫面設計',
    engine: null,
    web: '拖曳式 SCADA 儀表板編輯器（量表／開關／警報元件），發布後畫面立即生效',
  },
  {
    cat: '帳號權限',
    engine: null,
    web: 'RBAC 角色權限控制與登入時效管理',
  },
];
---

<section class="section section-alt" id="tech-specs">
  <div class="container">
    <div class="section-head">
      <h2>給系統整合商與資訊部門</h2>
      <p>
        後端 Engine 是 7×24 常駐服務，負責資料採集、警報比對與自動控制；前端 Web
        儀表板用來監看即時狀態、設定規則與設計畫面。兩端透過 MQTT 即時串接，歷史資料統一寫入
        SQL Server。
      </p>
    </div>

    <details class="card spec-card">
      <summary>
        展開完整規格表（{rows.length} 項）
        <svg
          class="spec-chevron"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 9l6 6 6-6" />
        </svg>
      </summary>
      <table class="spec-table">
        <thead>
          <tr>
            <th scope="col">類別</th>
            <th scope="col">後端 Engine（背景服務）</th>
            <th scope="col">前端 Web 儀表板</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <th scope="row">{r.cat}</th>
                <td class:list={{ empty: !r.engine }} data-label="後端 Engine">
                  {r.engine ?? <><span aria-hidden="true">—</span><span class="sr-only">不適用</span></>}
                </td>
                <td class:list={{ empty: !r.web }} data-label="Web 儀表板">
                  {r.web ?? <><span aria-hidden="true">—</span><span class="sr-only">不適用</span></>}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </details>

    <p class="spec-note">
      需要完整的系統架構與部署規格文件？<a href="#contact">來信索取</a>
    </p>
  </div>
</section>

<style>
  .spec-card {
    padding: 0;
  }

  .spec-card summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 24px;
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .spec-card summary::-webkit-details-marker {
    display: none;
  }

  .spec-chevron {
    flex-shrink: 0;
    color: var(--c-green-deep);
    transition: transform 0.2s ease;
  }

  .spec-card[open] .spec-chevron {
    transform: rotate(180deg);
  }

  .spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    border-top: 1px solid var(--border);
  }

  .spec-table thead th {
    background: color-mix(in srgb, var(--c-teal) 10%, var(--surface));
    color: var(--ink);
    font-size: 0.95rem;
    text-align: left;
    padding: 14px 20px;
    border-bottom: 1px solid color-mix(in srgb, var(--c-teal) 35%, var(--border));
    white-space: nowrap;
  }

  .spec-table tbody th {
    text-align: left;
    color: var(--ink);
    white-space: nowrap;
    font-weight: 700;
  }

  .spec-table tbody th,
  .spec-table td {
    padding: 12px 20px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .spec-table tbody tr:last-child th,
  .spec-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .spec-table td {
    color: var(--ink-2);
  }

  .spec-table td.empty {
    color: var(--ink-3);
  }

  .spec-note {
    margin: 20px 0 0;
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .spec-note a {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* 窄螢幕：每一列改成直式區塊，不需要橫向捲動；不適用的欄位直接隱藏 */
  @media (max-width: 700px) {
    .spec-table thead {
      display: none;
    }

    .spec-table,
    .spec-table tbody,
    .spec-table tr,
    .spec-table th,
    .spec-table td {
      display: block;
    }

    .spec-table tr {
      padding: 14px 20px;
      border-bottom: 1px solid var(--border);
    }

    .spec-table tbody tr:last-child {
      border-bottom: 0;
    }

    .spec-table tbody th,
    .spec-table td {
      padding: 0;
      border: 0;
      white-space: normal;
    }

    .spec-table tbody th {
      margin-bottom: 6px;
    }

    .spec-table td + td {
      margin-top: 6px;
    }

    .spec-table td::before {
      content: attr(data-label) '：';
      font-weight: 600;
      color: var(--ink);
    }

    .spec-table td.empty {
      display: none;
    }
  }
</style>
