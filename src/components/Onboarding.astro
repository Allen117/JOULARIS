---
// 導入流程：主打不需更換硬體、可小規模起步，並在此放置中段 CTA
const steps = [
  {
    title: '現場評估',
    desc: '盤點既有電表、感測器與設備的通訊介面，一起確認監控範圍與最想解決的問題。',
  },
  {
    title: '接上既有設備',
    desc: '透過 Modbus、OPC UA 或資料庫介接，數據直接進入系統。可以先從幾個重點電表開始。',
  },
  {
    title: '上線監控，逐步優化',
    desc: '即時監控與警報馬上啟用；數據累積後，系統會指出最值得先改善的節能空間。',
  },
];
---

<section class="section" id="onboarding">
  <div class="container">
    <div class="section-head">
      <h2>不用換硬體，從現有電表開始</h2>
      <p>先接幾個重點電表，確認效益之後，再擴充到整棟建物的空調與能源監控。</p>
    </div>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step">
            <span class="step-num" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </li>
        ))
      }
    </ol>

    <div class="onboard-cta">
      <p>想知道你的建物可以從哪裡開始？</p>
      <a class="btn btn-primary" href="#contact">預約現場評估</a>
    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }

  .step {
    position: relative;
    padding-top: 56px;
  }

  /* 步驟之間的連接線 */
  .step::before {
    content: '';
    position: absolute;
    top: 17px;
    left: 44px;
    right: -32px;
    height: 2px;
    background: var(--border);
  }

  .step:last-child::before {
    display: none;
  }

  .step-num {
    position: absolute;
    top: 0;
    left: 0;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--c-green-deep);
    color: var(--c-green-deep);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .step h3 {
    font-size: 1.15rem;
    margin-bottom: 8px;
  }

  .step p {
    font-size: 0.97rem;
    margin: 0;
  }

  .onboard-cta {
    margin-top: 64px;
    padding: 28px 32px;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--c-green) 10%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--c-green) 25%, var(--border));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .onboard-cta p {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .step {
      padding: 4px 0 0 56px;
    }

    .step::before {
      top: 44px;
      left: 17px;
      right: auto;
      bottom: -28px;
      width: 2px;
      height: auto;
    }

    .onboard-cta {
      padding: 24px;
    }
  }
</style>
