---
// 為什麼選 JOULARIS
const points = [
  {
    title: '空調系統 AI 最佳化控制',
    desc: '依環境溫濕度與現場負載即時調整空調運轉策略，在維持舒適的前提下降低耗電。',
  },
  {
    title: '自動產出報表，AI 追蹤能耗',
    desc: '報表定期自動產出，AI 持續追蹤能耗變化，異常和浪費發生時能及早發現。',
  },
  {
    title: '工業級穩定',
    desc: '以 7×24 背景服務長期運轉，連線中斷後會自動重連，確保資料完整。',
  },
  {
    title: '模組化擴充',
    desc: '可以先從幾個電表開始導入，之後再依需求擴充到全廠的電、水、氣監控。',
  },
];
---

<section class="section" id="why-us">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Why JOULARIS</span>
      <h2>為什麼選 JOULARIS</h2>
    </div>
    <div class="grid grid-2">
      {
        points.map((p) => (
          <div class="card why">
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why h3 {
    font-size: 1.05rem;
    margin-bottom: 6px;
    padding-left: 14px;
    border-left: 4px solid var(--c-green);
  }

  .why p {
    font-size: 0.95rem;
    margin: 0;
  }
</style>
