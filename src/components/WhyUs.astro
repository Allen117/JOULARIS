---
// 為什麼選 JOULARIS
const points = [
  {
    title: '空調系統AI最佳化控制',
    desc: '依環境與負載即時調節空調運轉策略，兼顧舒適度與節能成效。',
  },
  {
    title: '自動報表生成・AI追蹤能耗',
    desc: '能源報表自動產出，AI持續追蹤能耗，異常與浪費一眼掌握。',
  },
  {
    title: '工業級穩定',
    desc: '7×24 背景服務長時間運轉，斷線自動重連、資料不漏接。',
  },
  {
    title: '模組化擴充',
    desc: '從單一電表到全廠電水氣，依需求逐步擴充，不必一次到位。',
  },
];
---

<section class="section" id="why-us">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Why JOULARIS</span>
      <h2>為什麼選 JOULARIS</h2>
    </div>
    <div class="grid grid-2">
      {
        points.map((p) => (
          <div class="card why">
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why h3 {
    font-size: 1.05rem;
    margin-bottom: 6px;
    padding-left: 14px;
    border-left: 4px solid var(--c-green);
  }

  .why p {
    font-size: 0.95rem;
    margin: 0;
  }
</style>
