---
// Hero：價值主張 + 預約展示 CTA + EMS 實際畫面（總覽 + ISO 50001 能源基準）
import ShotCrop from './ShotCrop.astro';
import emsDashboard from '../assets/ems-dashboard.png';
import energyBaseline from '../assets/energy-baseline.png';
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1>看清能源花在哪，<br />知道該從哪裡省</h1>
      <p class="lede">
        JOULARIS 是應用於商辦、廠房與校園的能源管理系統：空調自動控制、需量與電費即時追蹤、報表自動產出。
      </p>
      <p class="lede lede-key">
        <strong>直接讀取你現有的電表和設備，不用換硬體。</strong>
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#contact">預約產品展示</a>
        <a class="text-link" href="#features">先看它能做什麼</a>
      </div>
      <a
        class="itri-badge"
        href="https://www.itri.org.tw"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img src="/itri.png" alt="" width="20" height="20" />
        工研院 ITRI 技術研發
      </a>
    </div>

    <div class="hero-shots">
      <ShotCrop
        class="hero-main"
        src={emsDashboard}
        box={[0, 0, 2000, 1030]}
        alt="JOULARIS EMS 能源管理總覽：主要電表資訊、今日即時需量、逐時用電與去年同期比較"
        eager
      />
      <div class="hero-zoom">
        <ShotCrop
          src={energyBaseline}
          base={[1685, 949]}
          box={[0, 50, 1685, 899]}
          alt="ISO 50001 能源基準畫面：基線模型清單、模型定義與回歸結果（R² 0.9121、係數表、實際對預測散布圖）"
          eager
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 88px 0 40px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 56px;
    align-items: center;
    position: relative;
  }

  h1 {
    font-size: clamp(2.1rem, 4.4vw, 3.3rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0.01em;
    margin-bottom: 0.55em;
    text-wrap: balance;
  }

  .lede {
    font-size: 1.08rem;
    max-width: 30em;
    margin-bottom: 0.6em;
  }

  .lede-key {
    word-break: keep-all;
  }

  .lede-key strong {
    color: var(--ink);
  }

  .cta-row {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 28px;
    flex-wrap: wrap;
  }

  /* 工研院徽章：放在行動按鈕之後，作為信任補充而不是第一眼 */
  .itri-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 32px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink-3);
    transition: color 0.15s ease;
  }

  .itri-badge:hover {
    color: var(--ink);
  }

  .itri-badge img {
    display: block;
    border-radius: 4px;
  }

  /* ---- EMS 截圖：總覽在後、ISO 50001 能源基準畫面疊在左下 ---- */

  .hero-shots {
    position: relative;
    padding-bottom: 22%;
  }

  /* 兩張截圖寬度接近：總覽靠右上，ISO 50001 畫面疊在左下 */
  .hero-shots :global(.hero-main) {
    width: 80%;
    margin-left: auto;
    box-shadow: 0 6px 16px rgb(16 46 40 / 0.1);
  }

  .hero-zoom {
    position: absolute;
    left: -6%;
    bottom: 0;
    width: 78%;
    margin: 0;
  }

  .hero-zoom :global(.shot-crop) {
    box-shadow: 0 10px 20px rgb(16 46 40 / 0.18);
  }

  @media (max-width: 860px) {
    .hero {
      padding: 56px 0 64px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .hero-shots {
      padding-bottom: 0;
    }

    .hero-shots :global(.hero-main) {
      width: 90%;
    }

    .hero-zoom {
      position: relative;
      left: auto;
      width: 90%;
      margin: -12% 0 0;
    }
  }
</style>
