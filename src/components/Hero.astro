---
// Hero：主標語 + CTA + EMS 系統實際畫面截圖
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1>JOULARIS</h1>
      <p class="tagline">幫你找到節能的方向</p>
      <p class="lede">
        整合電、水、氣即時監控與費用分析的工業能源管理系統，
        用數據告訴你能源花在哪裡、<strong>該從哪裡開始省</strong>。
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#features">了解產品</a>
        <a class="btn btn-ghost" href="#contact">聯絡我們</a>
      </div>
    </div>

    <div class="hero-shots">
      <div class="hero-shot hero-shot-main card">
        <img
          src="/ems-dashboard.png"
          alt="JOULARIS EMS 能源管理系統即時總覽畫面"
          width="2520"
          height="1575"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="hero-shot hero-shot-sub card">
        <img
          src="/logicflow-hvac-v5.png"
          alt="JOULARIS EMS 流程圖控制（LogicFlow）空調最佳化畫面"
          width="2520"
          height="1575"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 96px 0 88px;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: -40% -20% auto auto;
    width: 70%;
    aspect-ratio: 1;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--c-green) 18%, transparent),
      transparent 65%
    );
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: auto auto -45% -15%;
    width: 60%;
    aspect-ratio: 1;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--c-blue) 14%, transparent),
      transparent 65%
    );
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 48px;
    align-items: center;
    position: relative;
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 3.8rem);
    letter-spacing: 0.08em;
    margin-bottom: 0.15em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .tagline {
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.6em;
  }

  .lede {
    font-size: 1.05rem;
    max-width: 30em;
  }

  .cta-row {
    display: flex;
    gap: 16px;
    margin-top: 28px;
    flex-wrap: wrap;
  }

  /* ---- EMS 系統截圖 ---- */

  .hero-shots {
    position: relative;
  }

  .hero-shot {
    padding: 10px;
    overflow: hidden;
  }

  .hero-shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  /* 主圖靠右、副圖略小靠左，上下稍微錯開重疊 */
  .hero-shot-main {
    width: 92%;
    margin-left: auto;
    position: relative;
  }

  .hero-shot-sub {
    width: 85%;
    margin: -14% 0 0 -4%;
    position: relative;
    z-index: 2;
    box-shadow: 0 18px 44px rgb(16 46 58 / 0.22);
  }

  @media (max-width: 860px) {
    .hero {
      padding: 64px 0;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .hero-shots {
      display: grid;
      gap: 16px;
    }

    .hero-shot-main,
    .hero-shot-sub {
      width: 100%;
      margin: 0;
      box-shadow: none;
    }
  }
</style>
