---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <img src="/logo.svg" alt="JOULARIS" width="160" height="38" />
    <div class="footer-meta">
      <p>© {year} JOULARIS｜名稱取自 Joule（焦耳）與 Polaris（北極星）：替你在能源數據裡指出方向</p>
      <a
        class="powered-by"
        href="https://www.itri.org.tw"
        target="_blank"
        rel="noopener noreferrer"
      >
        Powered by
        <img src="/itri.png" alt="ITRI 工業技術研究院" width="20" height="20" />
        ITRI
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 32px 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer-inner p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-3);
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .powered-by {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--ink-3);
    text-decoration: none;
  }

  .powered-by:hover {
    color: var(--ink);
  }

  .powered-by img {
    display: block;
    border-radius: 4px;
  }
</style>
