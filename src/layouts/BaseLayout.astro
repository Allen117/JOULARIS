---
import '../styles/global.css';
import BgMotion from '../components/BgMotion.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'JOULARIS｜幫你找到節能的方向',
  description =
    'JOULARIS 工商能源管理系統，空調控制、能源監控與費用分析，用數據告訴你能源花在哪裡、該從哪裡開始省。',
} = Astro.props;

const siteUrl = Astro.site ?? Astro.url;
const ogImage = new URL('/og.png', siteUrl);

// Organization 結構化資料（不放 email，避免明文被爬蟲蒐集）
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'JOULARIS',
  url: siteUrl.toString(),
  logo: new URL('/logo.png', siteUrl).toString(),
  slogan: '幫你找到節能的方向',
  description:
    'JOULARIS 工商能源管理系統，空調控制、能源監控與費用分析，用數據告訴你能源花在哪裡、該從哪裡開始省。',
};
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={Astro.site ?? Astro.url} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JOULARIS" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="zh_TW" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  </head>
  <body>
    <BgMotion />
    <header class="nav">
      <div class="container nav-inner">
        <a class="nav-logo" href="#top" aria-label="JOULARIS 回到頁首">
          <img src="/logo.svg" alt="JOULARIS" width="200" height="47" />
        </a>
        <nav aria-label="主選單">
          <button
            class="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="nav-menu"
            aria-label="開啟選單"
          >
            <svg class="icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
          <ul class="nav-links" id="nav-menu">
            <li><a href="#features">產品特色</a></li>
            <li><a href="#use-cases">應用場景</a></li>
            <li><a href="#why-us">為什麼選我們</a></li>
            <li><a href="#tech-specs">技術架構</a></li>
            <li><a href="#faq">常見問題</a></li>
            <li><a href="#contact" class="btn btn-soft" style="padding:8px 20px;">聯絡我們</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="top">
      <slot />
    </main>
    <script>
      const nav = document.querySelector('.nav');
      const toggle = document.querySelector('.nav-toggle');
      if (nav && toggle) {
        const close = () => {
          nav.classList.remove('menu-open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', '開啟選單');
        };
        toggle.addEventListener('click', () => {
          const open = nav.classList.toggle('menu-open');
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? '關閉選單' : '開啟選單');
        });
        nav.querySelectorAll('.nav-links a').forEach((a) => a.addEventListener('click', close));
      }
    </script>
  </body>
</html>
