{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnergyAggregation": {
    "MaxStalenessHours": 2
  },
  "RefrigerationTonAggregation": {
    "MinCoveragePercent": 90
  },
  "ScadaPageAccumulation": {
    "MaxStalenessHours": 2,
    "MaxGapMinutes": 5,
    "ResultCacheSeconds": 30
  },
  "ElectricityCost": {
    "CatchUpDays": 7
  },
  "EngineModbusConfig": {
    "WatchedFolder": "../../Engine/App/Modbus"
  },
  "EngineOpcUaConfig": {
    "WatchedFolder": "../../Engine/App/OpcUaPoint"
  },
  "EngineDbPointConfig": {
    "WatchedFolder": "../../Engine/App/DBPoint"
  }
}
