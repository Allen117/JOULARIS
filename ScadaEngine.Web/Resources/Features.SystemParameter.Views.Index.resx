  <data name="sysparam.title" xml:space="preserve"><value>系統參數</value></data>
  <data name="sysparam.hint.page" xml:space="preserve"><value>工程師專屬。修改後按「儲存」，下一次操作即生效，不需重啟服務。</value></data>
  <data name="sysparam.group.history" xml:space="preserve"><value>歷史趨勢</value></data>
