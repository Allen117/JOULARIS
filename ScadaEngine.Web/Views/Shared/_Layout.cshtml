                        }
                    </ul>
                </div>
            </div>
        </nav>
    }

    <!-- HASP 授權失效跑馬燈（預設隱藏，license-monitor.js 控制顯示） -->
    <div id="license-warning-banner"
         style="display:none; background:#dc3545; color:#fff; padding:6px 16px;
                align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
        <span>
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>&#9888; Engine 授權驗證失效</strong> &mdash; 資料採集已暫停
        </span>
        <button id="license-verify-btn"
                class="btn btn-sm btn-light"
                onclick="window._licenseMonitor.triggerVerify()">
            <i class="fas fa-sync-alt me-1"></i>立即重新驗證
        </button>
    </div>

    <!-- 主要內容 -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- 頁腳 -->
    @if (ViewData["ShowNavigation"]?.ToString() != "false")
    {
        <footer class="footer mt-auto">
            <div class="container-fluid">
                <div class="d-flex flex-wrap justify-content-between align-items-center">
                    <span class="me-3 d-inline-flex align-items-center">
                        <svg class="footer-logo" viewBox="0 0 510 120" role="img"
                             aria-label="@Localizer["layout.footer.platform"]">
                            <title>@Localizer["layout.footer.platform"]</title>
                            <!-- 指北星：北向長芒 -->
                            <path class="footer-logo-star" d="M57 4 L70 47 L101 60 L70 73 L57 116 L44 73 L13 60 L44 47 Z" />
                            <!-- 東北方小星芒 -->
                            <path class="footer-logo-spark" d="M100 12 L104 24 L116 28 L104 32 L100 44 L96 32 L84 28 L96 24 Z" />
                            <text class="footer-logo-word" x="138" y="80" textLength="340" lengthAdjust="spacingAndGlyphs">JOULARIS</text>
                        </svg>
                    </span>
                    <span class="me-3 d-inline-flex align-items-center">
                        @* 產品版號唯一來源 = Directory.Build.props <Version>，經 AppVersion 讀組件屬性（CLAUDE.md §版本號規則） *@
                        <i class="fas fa-code me-1"></i>@Localizer["layout.footer.version", ScadaEngine.Web.Services.AppVersion.szCurrent]
                        <img src="~/images/itri-logo.svg" alt="ITRI" style="height:18px;vertical-align:middle;" class="ms-2" />
                    </span>
                    <span>
                        <small>
                            <i class="fas fa-server me-1"></i>@Localizer["layout.footer.server_time"]: <span id="serverClock"></span>
                        </small>
                    </span>
                </div>
            </div>
        </footer>
    }

    <!-- 登出確認 Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title" id="logoutModalLabel">
                        <i class="fas fa-sign-out-alt text-danger me-2"></i>@Localizer["layout.logout.title"]
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center py-3">
                    <p class="mb-1">@Localizer["layout.logout.confirm"]</p>
                    <small class="text-muted">@Localizer["layout.logout.notice"]</small>
                </div>
                <div class="modal-footer border-0 pt-0 justify-content-center gap-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@Localizer["layout.logout.cancel"]</button>
                    <button type="button" class="btn btn-danger btn-sm" onclick="confirmLogout()">@Localizer["layout.logout.confirm_btn"]</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 全站搜尋 Modal（Ctrl+K 命令面板） -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="modal fade" id="globalSearchModal" tabindex="-1" aria-label="@Localizer["layout.search.title"]" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="gs-input-wrap">
                        <i class="fas fa-search text-primary"></i>
                        <input id="globalSearchInput" type="text" class="form-control"
                               placeholder="@Localizer["layout.search.placeholder"]"
                               aria-label="@Localizer["layout.search.title"]" autocomplete="off" />
                        <kbd>Esc</kbd>
                    </div>
                    <div id="globalSearchResults" class="gs-results"></div>
                    <div class="gs-footer text-muted">@Localizer["layout.search.hint"]</div>
                </div>
            </div>
        </div>
    }

    <!-- 登出用隱藏表單 (POST + AntiForgeryToken) -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form id="logoutForm" action="/Login/Logout" method="post" style="display:none">
            @Html.AntiForgeryToken()
        </form>
    }

    <!-- 右下角智慧助理（AI智慧幫手）掛載點 — DOM 由 scada-assistant.js 建立 -->
    @if (User.Identity?.IsAuthenticated == true && canAccess("/EnergyDeclaration"))
    {
        <div id="scadaAssistantRoot"></div>
    }

    <!-- Bootstrap JavaScript Bundle (本機) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- i18n helper（要在頁面其他 JS 之前載入）-->
    <script src="~/js/i18n.js"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- 全站搜尋（Ctrl+K） -->
        <script src="~/js/global-search.js"></script>
        <!-- 全站警報音 + 靜音 -->
        <script src="~/js/alarm-sound.js" asp-append-version="true"></script>
    }

    @* 右下角智慧助理（AI智慧幫手）— i18n.js 之後載入，字串走 window.i18n.t *@
    @if (User.Identity?.IsAuthenticated == true && canAccess("/EnergyDeclaration"))
    {
        <script src="~/js/scada-assistant.js"></script>
    }

    <script>
        (function () {
            function updateClock() {
                var now = new Date();
                var pad = function (n) { return n.toString().padStart(2, '0'); };
                var s = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate()) +
                    ' ' + pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
                var el = document.getElementById('serverClock');
                if (el) el.textContent = s;
            }
            updateClock();
            setInterval(updateClock, 1000);
        })();

        function showLogoutModal(e) {
            e.preventDefault();
            new bootstrap.Modal(document.getElementById('logoutModal')).show();
        }
        function confirmLogout() {
            document.getElementById('logoutForm').submit();
        }

        function setSiteCulture(e, culture) {
            e.preventDefault();
            if (window.i18n && typeof window.i18n.setCulture === 'function') {
                window.i18n.setCulture(culture);
            } else {
                // fallback：直接 POST 後 reload
                fetch('/api/i18n/set-culture?culture=' + encodeURIComponent(culture), { method: 'POST', credentials: 'same-origin' })
                    .then(function () { window.location.reload(); });
            }
        }

        // 多層下拉選單的展開行為一律在 wwwroot/js/navbar-submenu.js，此處不得再寫一份：
        // 兩份都掛 click 監聽會各 toggle 一次 show，互相抵銷，點擊便展不開子選單。
    </script>

    <!-- 導覽列子選單 -->
    <script src="~/js/navbar-submenu.js"></script>

    <!-- 授權守衛監控 -->
    <script src="~/js/license-monitor.js"></script>

    <!-- 頁面特定 JavaScript -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
