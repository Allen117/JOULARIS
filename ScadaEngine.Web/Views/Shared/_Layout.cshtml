                                                <li><a class="dropdown-item" href="/DbCoordinator"><i class="fas fa-database me-2"></i>@Localizer["layout.menu.dbcoordinator"]</a></li>
                                                <li><a class="dropdown-item" href="/OpcUaCoordinator"><i class="fas fa-plug me-2"></i>@Localizer["layout.menu.opcuacoordinator"]</a></li>
