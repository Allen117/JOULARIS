                                <a class="nav-link" href="/ScadaPage">
                                    <i class="fas fa-arrow-left me-1"></i>
                                    @Localizer["layout.ems.back_scada"]
                                </a>
                            </li>
                        }
                        else if (!isEmsMode && canAccess("/EMS"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/EMS">
                                    <i class="fas fa-arrow-left me-1"></i>
                                    @Localizer["layout.scada.back_ems"]
                                </a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- 全站警報音：瀏覽器擋自動播放時的啟用提示（alarm-sound.js 控制顯示） -->
                            <li class="nav-item d-none" id="alarmSoundUnlock">
                                <a class="nav-link" href="#" data-as-action="unlock">
                                    <i class="fas fa-volume-up me-1"></i>@Localizer["layout.alarm_sound.unlock"]
                                </a>
                            </li>
                            <!-- 全站警報音鈴鐺 -->
                            <li class="nav-item dropdown" id="alarmSoundNav">
                                <a class="nav-link dropdown-toggle as-bell" href="#" role="button" data-bs-toggle="dropdown"
                                   title="@Localizer["layout.alarm_sound.title"]" aria-label="@Localizer["layout.alarm_sound.title"]">
                                    <i class="fas fa-bell" id="alarmSoundIcon"></i><span class="as-count d-none" id="alarmSoundCount">0</span><span class="as-snooze d-none" id="alarmSoundSnooze"></span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><span class="dropdown-item-text" id="alarmSoundStatus">@Localizer["layout.alarm_sound.status.normal"]</span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="#" data-as-action="silence"><i class="fas fa-volume-mute me-2"></i>@Localizer["layout.alarm_sound.silence"]</a></li>
                                    <li><h6 class="dropdown-header">@Localizer["layout.alarm_sound.snooze"]</h6></li>
                                    <li><a class="dropdown-item" href="#" data-as-action="snooze" data-min="5"><i class="fas fa-bell-slash me-2"></i>@Localizer["layout.alarm_sound.snooze_min", 5]</a></li>
                                    <li><a class="dropdown-item" href="#" data-as-action="snooze" data-min="15"><i class="fas fa-bell-slash me-2"></i>@Localizer["layout.alarm_sound.snooze_min", 15]</a></li>
                                    <li><a class="dropdown-item" href="#" data-as-action="snooze" data-min="30"><i class="fas fa-bell-slash me-2"></i>@Localizer["layout.alarm_sound.snooze_min", 30]</a></li>
                                    <li class="d-none" id="alarmSoundResume"><a class="dropdown-item" href="#" data-as-action="resume"><i class="fas fa-bell me-2"></i>@Localizer["layout.alarm_sound.resume"]</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="#" data-as-action="test"><i class="fas fa-play me-2"></i>@Localizer["layout.alarm_sound.test"]</a></li>
                                    @if (canAccess("/ScadaPage"))
                                    {
                                        <li><a class="dropdown-item" href="/ScadaPage"><i class="fas fa-list me-2"></i>@Localizer["layout.alarm_sound.view_alarms"]</a></li>
                                    }
                                    else if (canAccess("/EventLog"))
                                    {
                                        <li><a class="dropdown-item" href="/EventLog"><i class="fas fa-list me-2"></i>@Localizer["layout.alarm_sound.view_alarms"]</a></li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- 全站搜尋（Ctrl+K） -->
                            <li class="nav-item">
                                <a class="nav-link" href="#" title="@Localizer["layout.search.title"] (Ctrl+K)"
                                   onclick="window._globalSearch.open(event)">
                                    <i class="fas fa-search me-1"></i><span class="d-none d-lg-inline">@Localizer["layout.search.nav_hint"]</span>
                                    <span class="gs-nav-kbd d-none d-xl-inline ms-1"><kbd>Ctrl</kbd> <kbd>K</kbd></span>
                                </a>
