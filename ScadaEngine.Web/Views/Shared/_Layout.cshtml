@using ScadaEngine.Web.Services
@using System.Globalization
@{
    bool canAccess(string route) => PermissionService.CanAccessPage(User, route);
    var szCurrentCulture = CultureInfo.CurrentUICulture.Name;
    var szCurrentLangLabel = szCurrentCulture.StartsWith("en") ? "EN" : "台灣";
    var szReturnUrl = Context.Request.Path + Context.Request.QueryString;
    bool isEmsMode = ViewData["EmsMode"] as bool? == true
        || PermissionService.IsEmsRoute(Context.Request.Path.Value)
        || Context.Request.Query["ems"] == "1";
    var szBodyClass = isEmsMode ? "d-flex flex-column ems-mode" : "d-flex flex-column";
    var szNavbarClass = isEmsMode
        ? "navbar navbar-expand-lg navbar-light"
        : "navbar navbar-expand-lg navbar-dark bg-primary";
    var szBrandKey = isEmsMode ? "layout.brand.ems" : "layout.brand";
    var szBrandIcon = isEmsMode ? "fas fa-leaf me-2" : "fas fa-industry me-2";
}
<!DOCTYPE html>
<html lang="@szCurrentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["layout.brand"]</title>

    <!-- Favicon（JOULARIS 星芒；不支援 SVG 的舊瀏覽器退回 favicon.ico） -->
    <link rel="icon" type="image/svg+xml" href="~/images/logo-mark.svg" asp-append-version="true">
    <link rel="alternate icon" href="~/favicon.ico" asp-append-version="true">

    <!-- Bootstrap CSS (本機) -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6 Icons (本機) -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css">

    <!-- 導覽列子選單 -->
    <link rel="stylesheet" href="~/css/navbar-submenu.css">

    <!-- 全站搜尋（Ctrl+K） -->
    <link rel="stylesheet" href="~/css/global-search.css">

    <!-- 全站警報音鈴鐺 -->
    <link rel="stylesheet" href="~/css/alarm-sound.css" asp-append-version="true">

    @* 右下角智慧助理（AI智慧幫手）— 需登入且有能源申報權限 *@
    @if (User.Identity?.IsAuthenticated == true && canAccess("/EnergyDeclaration"))
    {
        <link rel="stylesheet" href="~/css/scada-assistant.css">
    }

    @if (isEmsMode)
    {
        <link rel="stylesheet" href="~/css/ems.css">
    }

    <!-- 自訂樣式 -->
    <style>
        html, body {
            overflow-x: hidden;
        }
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        .navbar {
            box-shadow: 0 2px 4px rgba(0,0,0,.1);
        }

        /* 避免英文標籤過長造成 nav-link 換行；超寬時改為橫向溢出 */
        .navbar .nav-link {
            white-space: nowrap;
        }
        .navbar-collapse {
            flex-wrap: nowrap;
        }

        .footer {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 8px 0;
            margin-top: auto;
        }

        /* 頁尾品牌 wordmark（取代原「SCADA 智慧能源管理平台」文字）。
           內嵌 SVG 而非 <img>，星芒與文字顏色才能由 CSS 依 SCADA / EMS 主題覆寫 */
        .footer-logo {
            height: 22px;
            width: auto;
            display: block;
        }

        .footer-logo-word {
            fill: #ffffff;
            font: 800 56px 'Segoe UI', system-ui, -apple-system, sans-serif;
            letter-spacing: 3px;
        }

        /* SCADA：紫藍頁尾漸層上用同色系淺色階，星芒不與白字搶視覺 */
        .footer-logo-star {
            fill: #e0e7ff;
        }

        .footer-logo-spark {
            fill: #c7d2fe;
        }

        main {
            min-height: calc(100vh - 140px);
        }

        .card {
            border: none;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
        }

        .btn-primary {
            background: linear-gradient(45deg, #007bff, #0056b3);
            border: none;
        }

        .btn-primary:hover {
            background: linear-gradient(45deg, #0056b3, #004085);
            transform: translateY(-1px);
        }

        .text-primary {
            color: #007bff !important;
        }

        @* 多層下拉選單樣式一律在 wwwroot/css/navbar-submenu.css，此處不得再寫一份：
           曾有一份 inline 複本排在該檔之後、且選擇器多一個 a（特異性較高），
           把外部檔的箭頭形狀蓋掉，造成「改了 css 卻沒生效」與箭頭朝上。 *@
    </style>
</head>
<body class="@szBodyClass">
    <!-- 導覽列 -->
    @if (ViewData["ShowNavigation"]?.ToString() != "false")
    {
        <nav class="@szNavbarClass">
            <div class="container-fluid">
                <a class="navbar-brand" href="@(isEmsMode ? "/EMS" : "/ScadaPage")">
                    <i class="@szBrandIcon"></i>
                    @Localizer[szBrandKey]
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        @if (isEmsMode)
                        {
                            @if (canAccess("/ChilledWaterCircuitInfo") || canAccess("/ElectricityCircuitInfo") || canAccess("/WaterCircuitInfo") || canAccess("/GasCircuitInfo"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-plug me-1"></i>
                                        @Localizer["layout.menu.circuit_info"]
                                    </a>
                                    <ul class="dropdown-menu">
                                        @if (canAccess("/ChilledWaterCircuitInfo"))
                                        {
                                            <li><a class="dropdown-item" href="/ChilledWaterCircuitInfo"><i class="fas fa-snowflake me-2"></i>@Localizer["layout.menu.chilled_water_circuit_info"]</a></li>
                                        }
                                        @if (canAccess("/ElectricityCircuitInfo"))
                                        {
                                            <li><a class="dropdown-item" href="/ElectricityCircuitInfo"><i class="fas fa-bolt me-2"></i>@Localizer["layout.menu.electricity_circuit_info"]</a></li>
                                        }
                                        @if (canAccess("/WaterCircuitInfo"))
                                        {
                                            <li><a class="dropdown-item" href="/WaterCircuitInfo"><i class="fas fa-water me-2"></i>@Localizer["layout.menu.water_circuit_info"]</a></li>
                                        }
                                        @if (canAccess("/GasCircuitInfo"))
                                        {
                                            <li><a class="dropdown-item" href="/GasCircuitInfo"><i class="fas fa-fire me-2"></i>@Localizer["layout.menu.gas_circuit_info"]</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                            @if (canAccess("/ChillerEfficiency") || canAccess("/CompressorEfficiency"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-gauge-high me-1"></i>
                                        @Localizer["layout.menu.equipment_efficiency"]
                                    </a>
                                    <ul class="dropdown-menu">
                                        @if (canAccess("/ChillerEfficiency"))
                                        {
                                            <li><a class="dropdown-item" href="/ChillerEfficiency"><i class="fas fa-temperature-low me-2"></i>@Localizer["layout.menu.chiller_efficiency"]</a></li>
                                        }
                                        @if (canAccess("/CompressorEfficiency"))
                                        {
                                            <li><a class="dropdown-item" href="/CompressorEfficiency"><i class="fas fa-compress-arrows-alt me-2"></i>@Localizer["layout.menu.compressor_efficiency"]</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                            @if (canAccess("/EnergyReport") || canAccess("/ElectricityCostReport") || canAccess("/ContractCapacity") || canAccess("/RefrigerationTonReport") || canAccess("/WaterUsageReport") || canAccess("/WaterCostReport") || canAccess("/GasUsageReport") || canAccess("/GasCostReport") || canAccess("/EnergyDeclaration") || canAccess("/AirCompressorDeclaration"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-file-alt me-1"></i>
                                        @Localizer["layout.menu.reports"]
                                    </a>
                                    <ul class="dropdown-menu">
                                        @if (canAccess("/EnergyReport"))
                                        {
                                            <li><a class="dropdown-item" href="/EnergyReport"><i class="fas fa-chart-bar me-2"></i>@Localizer["layout.menu.energy_report"]</a></li>
                                        }
                                        @if (canAccess("/ElectricityCostReport"))
                                        {
                                            <li><a class="dropdown-item" href="/ElectricityCostReport"><i class="fas fa-file-invoice-dollar me-2"></i>@Localizer["layout.menu.electricity_cost_report"]</a></li>
                                        }
                                        @if (canAccess("/ContractCapacity"))
                                        {
                                            <li><a class="dropdown-item" href="/ContractCapacity"><i class="fas fa-sliders-h me-2"></i>@Localizer["layout.menu.contract_capacity"]</a></li>
                                        }
                                        @if (canAccess("/RefrigerationTonReport"))
                                        {
                                            <li><a class="dropdown-item" href="/RefrigerationTonReport"><i class="fas fa-snowflake me-2"></i>@Localizer["layout.menu.refrigeration_ton_report"]</a></li>
                                        }
                                        @if (canAccess("/WaterUsageReport"))
                                        {
                                            <li><a class="dropdown-item" href="/WaterUsageReport"><i class="fas fa-water me-2"></i>@Localizer["layout.menu.water_usage_report"]</a></li>
                                        }
                                        @if (canAccess("/WaterCostReport"))
                                        {
                                            <li><a class="dropdown-item" href="/WaterCostReport"><i class="fas fa-hand-holding-usd me-2"></i>@Localizer["layout.menu.water_cost_report"]</a></li>
                                        }
                                        @if (canAccess("/GasUsageReport"))
                                        {
                                            <li><a class="dropdown-item" href="/GasUsageReport"><i class="fas fa-fire me-2"></i>@Localizer["layout.menu.gas_usage_report"]</a></li>
                                        }
                                        @if (canAccess("/GasCostReport"))
                                        {
                                            @* fa-receipt：與同一選單內的「電費報表」fa-file-invoice-dollar 區隔 *@
                                            <li><a class="dropdown-item" href="/GasCostReport"><i class="fas fa-receipt me-2"></i>@Localizer["layout.menu.gas_cost_report"]</a></li>
                                        }
                                        @if (canAccess("/EnergyDeclaration"))
                                        {
                                            <li><a class="dropdown-item" href="/EnergyDeclaration"><i class="fas fa-file-signature me-2"></i>@Localizer["layout.menu.energy_declaration"]</a></li>
                                        }
                                        @* 權限獨立於 /EnergyDeclaration（後者另守門 AI 智慧幫手，勿合併判斷） *@
                                        @if (canAccess("/AirCompressorDeclaration"))
                                        {
                                            <li><a class="dropdown-item" href="/AirCompressorDeclaration"><i class="fas fa-wind me-2"></i>@Localizer["layout.menu.air_compressor_declaration"]</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                            @if (canAccess("/DailyReport"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/DailyReport">
                                        <i class="fas fa-newspaper me-1"></i>
                                        @Localizer["layout.menu.daily_report"]
                                    </a>
                                </li>
                            }
                            @if (canAccess("/EnergyBaseline"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/EnergyBaseline">
                                        <i class="fas fa-bullseye me-1"></i>
                                        @Localizer["layout.menu.energy_baseline"]
                                    </a>
                                </li>
                            }
                            @if (canAccess("/ChilledWaterSystem") || canAccess("/EnergyMeter") || canAccess("/WaterMeterSetting") || canAccess("/GasMeterSetting") || canAccess("/AirMeterSetting") || canAccess("/EquipmentEfficiencySetting") || canAccess("/BillingPeriodSetting") || canAccess("/WaterBillingPeriodSetting") || canAccess("/GasBillingPeriodSetting") || canAccess("/TariffSetting") || canAccess("/WaterTariffSetting") || canAccess("/GasTariffSetting") || canAccess("/HolidaySetting") || canAccess("/ShiftSetting") || canAccess("/EmsCardSetting") || canAccess("/DailyReportSetting"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-cog me-1"></i>
                                        @Localizer["layout.menu.ems_settings"]
                                    </a>
                                    <ul class="dropdown-menu">
                                        @if (canAccess("/ChilledWaterSystem"))
                                        {
                                            <li class="dropdown-submenu">
                                                <a class="dropdown-item dropdown-toggle" href="#" role="button"><i class="fas fa-water me-2"></i>@Localizer["layout.menu.group_water_system"]</a>
                                                <ul class="dropdown-menu">
                                                    <li><a class="dropdown-item" href="/ChilledWaterSystem"><i class="fas fa-tint me-2"></i>@Localizer["layout.menu.chilled_water"]</a></li>
                                                </ul>
                                            </li>
                                        }
                                        @if (canAccess("/EnergyMeter") || canAccess("/BillingPeriodSetting") || canAccess("/TariffSetting"))
                                        {
                                            <li class="dropdown-submenu">
                                                <a class="dropdown-item dropdown-toggle" href="#" role="button"><i class="fas fa-bolt me-2"></i>@Localizer["layout.menu.group_power_meter"]</a>
                                                <ul class="dropdown-menu">
                                                    @if (canAccess("/EnergyMeter"))
                                                    {
                                                        <li><a class="dropdown-item" href="/EnergyMeter"><i class="fas fa-sitemap me-2"></i>@Localizer["layout.menu.energy_meter"]</a></li>
                                                    }
                                                    @if (canAccess("/BillingPeriodSetting"))
                                                    {
                                                        <li><a class="dropdown-item" href="/BillingPeriodSetting"><i class="fas fa-calendar-check me-2"></i>@Localizer["layout.menu.billing_period"]</a></li>
                                                    }
                                                    @if (canAccess("/TariffSetting"))
                                                    {
                                                        <li><a class="dropdown-item" href="/TariffSetting"><i class="fas fa-file-invoice-dollar me-2"></i>@Localizer["layout.menu.tariff_setting"]</a></li>
                                                    }
                                                </ul>
                                            </li>
                                        }
                                        @if (canAccess("/WaterMeterSetting") || canAccess("/WaterBillingPeriodSetting") || canAccess("/WaterTariffSetting"))
                                        {
                                            <li class="dropdown-submenu">
                                                <a class="dropdown-item dropdown-toggle" href="#" role="button"><i class="fas fa-faucet me-2"></i>@Localizer["layout.menu.group_water_meter"]</a>
                                                <ul class="dropdown-menu">
                                                    @if (canAccess("/WaterMeterSetting"))
                                                    {
                                                        <li><a class="dropdown-item" href="/WaterMeterSetting"><i class="fas fa-faucet me-2"></i>@Localizer["layout.menu.water_meter"]</a></li>
                                                    }
                                                    @if (canAccess("/WaterBillingPeriodSetting"))
                                                    {
                                                        <li><a class="dropdown-item" href="/WaterBillingPeriodSetting"><i class="fas fa-calendar-day me-2"></i>@Localizer["layout.menu.water_billing_period"]</a></li>
                                                    }
                                                    @if (canAccess("/WaterTariffSetting"))
                                                    {
                                                        <li><a class="dropdown-item" href="/WaterTariffSetting"><i class="fas fa-tint me-2"></i>@Localizer["layout.menu.water_tariff_setting"]</a></li>
                                                    }
                                                </ul>
                                            </li>
                                        }
                                        @if (canAccess("/GasMeterSetting") || canAccess("/GasBillingPeriodSetting") || canAccess("/GasTariffSetting"))
                                        {
                                            <li class="dropdown-submenu">
                                                <a class="dropdown-item dropdown-toggle" href="#" role="button"><i class="fas fa-fire me-2"></i>@Localizer["layout.menu.group_gas_meter"]</a>
                                                <ul class="dropdown-menu">
                                                    @if (canAccess("/GasMeterSetting"))
                                                    {
                                                        <li><a class="dropdown-item" href="/GasMeterSetting"><i class="fas fa-gas-pump me-2"></i>@Localizer["layout.menu.gas_meter"]</a></li>
                                                    }
                                                    @if (canAccess("/GasBillingPeriodSetting"))
                                                    {
                                                        <li><a class="dropdown-item" href="/GasBillingPeriodSetting"><i class="fas fa-calendar-day me-2"></i>@Localizer["layout.menu.gas_billing_period"]</a></li>
                                                    }
                                                    @if (canAccess("/GasTariffSetting"))
                                                    {
                                                        @* fa-money-bill-wave：與所屬「氣表」群組標頭 fa-fire 區隔 *@
                                                        <li><a class="dropdown-item" href="/GasTariffSetting"><i class="fas fa-money-bill-wave me-2"></i>@Localizer["layout.menu.gas_tariff_setting"]</a></li>
                                                    }
                                                </ul>
                                            </li>
                                        }
                                        @if (canAccess("/AirMeterSetting"))
                                        {
                                            <li class="dropdown-submenu">
                                                <a class="dropdown-item dropdown-toggle" href="#" role="button"><i class="fas fa-wind me-2"></i>@Localizer["layout.menu.group_air_meter"]</a>
                                                <ul class="dropdown-menu">
                                                    <li><a class="dropdown-item" href="/AirMeterSetting"><i class="fas fa-wind me-2"></i>@Localizer["layout.menu.air_meter"]</a></li>
                                                </ul>
                                            </li>
                                        }
                                        @if (canAccess("/EquipmentEfficiencySetting"))
                                        {
                                            <li class="dropdown-submenu">
                                                <a class="dropdown-item dropdown-toggle" href="#" role="button"><i class="fas fa-gauge-high me-2"></i>@Localizer["layout.menu.equipment_efficiency"]</a>
                                                <ul class="dropdown-menu">
                                                    <li><a class="dropdown-item" href="/EquipmentEfficiencySetting"><i class="fas fa-sliders-h me-2"></i>@Localizer["layout.menu.equipment_efficiency_setting"]</a></li>
                                                </ul>
                                            </li>
                                        }
                                        @if (canAccess("/HolidaySetting") || canAccess("/ShiftSetting") || canAccess("/EmsCardSetting") || canAccess("/DailyReportSetting"))
                                        {
                                            <li class="dropdown-submenu">
                                                <a class="dropdown-item dropdown-toggle" href="#" role="button"><i class="fas fa-sliders-h me-2"></i>@Localizer["layout.menu.group_general_settings"]</a>
                                                <ul class="dropdown-menu">
                                                    @if (canAccess("/HolidaySetting"))
                                                    {
                                                        <li><a class="dropdown-item" href="/HolidaySetting"><i class="fas fa-calendar-day me-2"></i>@Localizer["layout.menu.holiday_setting"]</a></li>
                                                    }
                                                    @if (canAccess("/ShiftSetting"))
                                                    {
                                                        <li><a class="dropdown-item" href="/ShiftSetting"><i class="fas fa-user-clock me-2"></i>@Localizer["layout.menu.shift_setting"]</a></li>
                                                    }
                                                    @if (canAccess("/EmsCardSetting"))
                                                    {
                                                        <li><a class="dropdown-item" href="/EmsCardSetting"><i class="fas fa-th-large me-2"></i>@Localizer["layout.menu.ems_card_setting"]</a></li>
                                                    }
                                                    @if (canAccess("/DailyReportSetting"))
                                                    {
                                                        <li><a class="dropdown-item" href="/DailyReportSetting"><i class="fas fa-envelope-open-text me-2"></i>@Localizer["layout.menu.daily_report_setting"]</a></li>
                                                    }
                                                </ul>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                            @if (canAccess("/HistoryData") || canAccess("/EventLog"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-chart-line me-1"></i>
                                        @Localizer["layout.menu.history"]
                                    </a>
                                    <ul class="dropdown-menu">
                                        @if (canAccess("/HistoryData"))
                                        {
                                            <li><a class="dropdown-item" href="/HistoryData?ems=1"><i class="fas fa-chart-area me-2"></i>@Localizer["layout.menu.trend"]</a></li>
                                        }
                                        @if (canAccess("/EventLog"))
                                        {
                                            <li><a class="dropdown-item" href="/EventLog?ems=1"><i class="fas fa-clipboard-list me-2"></i>@Localizer["layout.menu.eventlog"]</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                        }
                        else
                        {
                            @if (canAccess("/ScadaPage"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/ScadaPage">
                                        <i class="fas fa-desktop me-1"></i>
                                        @Localizer["layout.menu.scadapage"]
                                    </a>
                                </li>
                            }
                            @if (canAccess("/RealTime"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/RealTime">
                                        <i class="fas fa-tachometer-alt me-1"></i>
                                        @Localizer["layout.menu.realtime"]
                                    </a>
                                </li>
                            }
                            @if (canAccess("/ConditionCtrl") || canAccess("/ScheduleSetting"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-microchip me-1"></i>
                                        @Localizer["layout.menu.control"]
                                    </a>
                                    <ul class="dropdown-menu">
                                        @if (canAccess("/ConditionCtrl"))
                                        {
                                            <li><a class="dropdown-item" href="/ConditionCtrl"><i class="fas fa-code-branch me-2"></i>@Localizer["layout.menu.condition"]</a></li>
                                        }
                                        @if (canAccess("/ScheduleSetting"))
                                        {
                                            <li><a class="dropdown-item" href="/ScheduleSetting"><i class="fas fa-calendar-alt me-2"></i>@Localizer["layout.menu.schedule"]</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                            @if (canAccess("/HistoryData") || canAccess("/EventLog"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-chart-line me-1"></i>
                                        @Localizer["layout.menu.history"]
                                    </a>
                                    <ul class="dropdown-menu">
                                        @if (canAccess("/HistoryData"))
                                        {
                                            <li><a class="dropdown-item" href="/HistoryData"><i class="fas fa-chart-area me-2"></i>@Localizer["layout.menu.trend"]</a></li>
                                        }
                                        @if (canAccess("/EventLog"))
                                        {
                                            <li><a class="dropdown-item" href="/EventLog"><i class="fas fa-clipboard-list me-2"></i>@Localizer["layout.menu.eventlog"]</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                            bool showSettings = canAccess("/AlarmSetting") || canAccess("/AccountSetting") || canAccess("/WeatherSetting");
                            @if (showSettings)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-cogs me-1"></i>
                                        @Localizer["layout.menu.system"]
                                    </a>
                                    <ul class="dropdown-menu">
                                        @if (canAccess("/AlarmSetting"))
                                        {
                                            <li><a class="dropdown-item" href="/AlarmSetting"><i class="fas fa-bell me-2"></i>@Localizer["layout.menu.alarm"]</a></li>
                                        }
                                        @if (canAccess("/WeatherSetting"))
                                        {
                                            <li><a class="dropdown-item" href="/WeatherSetting"><i class="fas fa-cloud-sun me-2"></i>@Localizer["layout.menu.weather"]</a></li>
                                        }
                                        @if (canAccess("/AccountSetting"))
                                        {
                                            <li><a class="dropdown-item" href="/AccountSetting"><i class="fas fa-users-cog me-2"></i>@Localizer["layout.menu.account"]</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                            @if (PermissionService.IsEngineer(User))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-hard-hat me-1"></i>
                                        @Localizer["layout.menu.engineer_mode"]
                                    </a>
