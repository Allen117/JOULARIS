<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JOULARIS</title>

    <!-- Favicon（JOULARIS 星芒；不支援 SVG 的舊瀏覽器退回 favicon.ico） -->
    <link rel="icon" type="image/svg+xml" href="~/images/logo-mark.svg" asp-append-version="true">
    <link rel="alternate icon" href="~/favicon.ico" asp-append-version="true">

    <!-- Bootstrap CSS -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome 圖示 -->
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" />
    <!-- 全域樣式 -->
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <!-- 登入頁面專用樣式 -->
    <link href="~/css/login.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <main role="main">
        @RenderBody()
    </main>

    <img src="~/images/itri-logo.svg"
         alt="ITRI"
         class="login-corner-logo"
         onerror="this.style.display='none'" />

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>