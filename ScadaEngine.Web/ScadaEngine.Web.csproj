<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyTitle>JOULARIS Web</AssemblyTitle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScadaEngine.Engine\ScadaEngine.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <!-- VUL-2026-001：ClosedXML → DocumentFormat.OpenXml 2.16 傳遞帶入 System.IO.Packaging 6.0.0（CVE-2024-43483 / 43484），顯式釘到修補版 -->
    <PackageReference Include="System.IO.Packaging" Version="8.0.1" />
    <!-- VUL-2026-002：EF Core SqlServer → SqlClient 傳遞帶入 Pkcs 8.0.1，與 Engine 同步釘版 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <!-- 能源基線 OLS 複回歸（QR 分解 + t 分布 p-value），見 docs/功能說明書_能源基線.md -->
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="NCalcSync" Version="6.3.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <!-- 線上使用手冊 Markdown → HTML，見 docs/功能說明書_使用手冊.md -->
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web 專案的配置檔案 -->
    <None Update="DatabaseSchema\DatabaseSchema.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Setting\tariff-taipower-defaults.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Setting\water-tariff-taiwater-defaults.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Setting\gas-tariff-defaults.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 內網 HTTPS 憑證（含私鑰）絕不打包進 publish/release，避免私鑰外洩。
         開發時 dotnet run 讀專案目錄 certs\scada-web.pfx（ContentRoot=專案目錄，不需 copy）；
         部署機由 certs\generate-https-cert.ps1 在該機現產，見 docs/功能說明書_內網HTTPS部署.md -->
    <None Update="certs\*.pfx" CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
    <!-- 線上使用手冊內容：不放 wwwroot（靜態檔不經授權），由 ManualController 依角色輸出 -->
    <None Update="Manual\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Web SDK 把 .json 歸為 Content，None Update 套不到，_toc.json 另外宣告 -->
    <Content Update="Manual\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Claude Code skill lock：開發用，不打包進 build/publish -->
    <Content Remove="skills-lock.json" />
    <None Remove="skills-lock.json" />
  </ItemGroup>

</Project>
