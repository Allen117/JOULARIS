@{
    ViewData["Title"] = "日報設定";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-2" style="max-width:1100px;">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="mb-0">
            <i class="fas fa-cog text-primary me-2"></i>日報設定
        </h2>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="/DailyReport">
                <i class="fas fa-newspaper me-1"></i>回日報頁
            </a>
            <button class="btn btn-outline-primary btn-sm" id="drsTestBtn" onclick="window._drs.testSend()">
                <i class="fas fa-paper-plane me-1"></i>測試寄送
            </button>
            <button class="btn btn-primary btn-sm" onclick="window._drs.saveSetting()">
                <i class="fas fa-save me-1"></i>儲存設定
            </button>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <!-- 寄送設定 -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light py-2">
                    <i class="fas fa-envelope me-1"></i>寄送設定
                </div>
                <div class="card-body p-3">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="drsMailEnabled">
                        <label class="form-check-label fw-semibold" for="drsMailEnabled">每日 02:00 自動寄送日報</label>
                        <div class="text-muted small">關閉時快照照常生成，僅不寄送；SMTP 連線設定沿用「警報通知」的 Email 設定</div>
                    </div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold">日報語言</label>
                            <select id="drsLanguage" class="form-select form-select-sm">
                                <option value="zh-TW">繁體中文</option>
                                <option value="en">English</option>
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold">差異提示門檻（&#177;%）</label>
                            <input type="number" id="drsThreshold" class="form-control form-control-sm" min="1" max="100" step="0.5">
                        </div>
                    </div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" id="drsHolidayHint">
                        <label class="form-check-label fw-semibold" for="drsHolidayHint">假日提示</label>
                        <div class="text-muted small">停用後假日徽章與假日類智慧提示皆不出現（24 小時生產場域適用）</div>
                    </div>
                </div>
            </div>

            <!-- 內容區塊 -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light py-2">
                    <i class="fas fa-th-list me-1"></i>內容區塊
                </div>
                <div class="card-body p-3">
                    <div class="row row-cols-2 g-2" id="drsSections">
                        <div class="col form-check ms-2"><input class="form-check-input dr-section-flag" type="checkbox" id="drsSec1" value="1"><label class="form-check-label" for="drsSec1">警報摘要</label></div>
                        <div class="col form-check ms-2"><input class="form-check-input dr-section-flag" type="checkbox" id="drsSec2" value="2"><label class="form-check-label" for="drsSec2">用電時報表</label></div>
                        <div class="col form-check ms-2"><input class="form-check-input dr-section-flag" type="checkbox" id="drsSec4" value="4"><label class="form-check-label" for="drsSec4">用水時報表</label></div>
                        <div class="col form-check ms-2"><input class="form-check-input dr-section-flag" type="checkbox" id="drsSec8" value="8"><label class="form-check-label" for="drsSec8">用氣時報表</label></div>
                        <div class="col form-check ms-2"><input class="form-check-input dr-section-flag" type="checkbox" id="drsSec16" value="16"><label class="form-check-label" for="drsSec16">冷凍噸時報表</label></div>
                        <div class="col form-check ms-2"><input class="form-check-input dr-section-flag" type="checkbox" id="drsSec32" value="32"><label class="form-check-label" for="drsSec32">單日比較</label></div>
                        <div class="col form-check ms-2"><input class="form-check-input dr-section-flag" type="checkbox" id="drsSec64" value="64"><label class="form-check-label" for="drsSec64">月累計比較</label></div>
                        <div class="col form-check ms-2"><input class="form-check-input dr-section-flag" type="checkbox" id="drsSec128" value="128"><label class="form-check-label" for="drsSec128">智慧摘要</label></div>
                        <div class="col form-check ms-2"><input class="form-check-input dr-section-flag" type="checkbox" id="drsSec256" value="256"><label class="form-check-label" for="drsSec256">空壓系統診斷</label></div>
                    </div>
                    <div class="text-muted small mt-2">未設定迴路的能源別（如冷凍噸）即使勾選也會自動隱藏</div>
                    <div class="text-muted small">空壓系統診斷：最近 7 天滾動規則式篩檢（預設不勾選；無啟用空壓機時自動隱藏）</div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <!-- 收件人清單 -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-users me-1"></i>收件人清單</span>
                    <span class="text-muted small">獨立於警報通知的收件群組</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0 align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Email</th>
                                    <th style="width:140px;">顯示名稱</th>
                                    <th style="width:70px;" class="text-center">啟用</th>
                                    <th style="width:70px;" class="text-center">刪除</th>
                                </tr>
                            </thead>
                            <tbody id="drsRecipientBody">
                                <tr><td colspan="4" class="text-center text-muted py-3">載入中…</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-light p-2">
                    <div class="input-group input-group-sm">
                        <input type="email" id="drsNewEmail" class="form-control" placeholder="email@example.com">
                        <input type="text" id="drsNewName" class="form-control" style="max-width:140px;" placeholder="顯示名稱（可空）">
                        <button class="btn btn-primary" onclick="window._drs.addRecipient()">
                            <i class="fas fa-plus me-1"></i>新增
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/dailyreport.css" asp-append-version="true" />

@section Scripts {
    <script src="~/js/dailyreportsetting.js" asp-append-version="true"></script>
}
