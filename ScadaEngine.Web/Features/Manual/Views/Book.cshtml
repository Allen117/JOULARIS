@model ScadaEngine.Web.Features.Manual.Models.ManualViewModel
@{
    var isEn = Model.isEnglish;
    var szBookTitle = Localizer[Model.book.szTitleKey].Value;
    ViewData["Title"] = Model.current.GetTitle(isEn) + " - " + szBookTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
    string? szLastGroup = null;
}

<div class="container-fluid mt-2 manual-page">
    <!-- 標題列：書名 + 切換其他手冊 + 列印 -->
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2 manual-noprint">
        <h2 class="mb-0">
            <span class="text-primary me-2"><partial name="~/Views/Shared/_ManualIcon.cshtml" /></span>
            <a href="/Manual" class="text-decoration-none text-body">@Localizer["manual.title"]</a>
            <span class="text-muted mx-1">/</span>
            <i class="@Model.book.szIcon text-primary me-1 manual-title-book-icon"></i>@szBookTitle
        </h2>
        <div class="d-flex gap-2">
            @if (Model.otherBooks.Count > 0)
            {
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="fas fa-exchange-alt me-1"></i>@Localizer["manual.switch_book"]
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @foreach (var other in Model.otherBooks)
                        {
                            <li><a class="dropdown-item" href="/Manual/@other.book.szKey/@other.szFirstSlug"><i class="@other.book.szIcon me-2"></i>@Localizer[other.book.szTitleKey]</a></li>
                        }
                    </ul>
                </div>
            }
            <button class="btn btn-sm btn-outline-secondary" type="button" onclick="window.print()">
                <i class="fas fa-print me-1"></i>@Localizer["manual.print"]
            </button>
        </div>
    </div>

    <div class="row g-3">
        <!-- 左：章節目錄（手機收合） -->
        <nav class="col-12 col-lg-3 col-xxl-2 manual-noprint" aria-label="@Localizer["manual.toc"]">
            <button class="btn btn-sm btn-outline-primary w-100 d-lg-none mb-2" type="button"
                    data-bs-toggle="collapse" data-bs-target="#manualToc" aria-expanded="false" aria-controls="manualToc">
                <i class="fas fa-list me-1"></i>@Localizer["manual.toc"]
            </button>
            <div class="collapse d-lg-block" id="manualToc">
                <div class="card shadow-sm manual-toc">
                    <div class="list-group list-group-flush">
                        @foreach (var c in Model.chapters)
                        {
                            var szGroup = c.GetGroup(isEn);
                            if (!string.IsNullOrEmpty(szGroup) && szGroup != szLastGroup)
                            {
                                szLastGroup = szGroup;
                                <div class="manual-toc-group">@szGroup</div>
                            }
                            var isActive = c.szSlug == Model.current.szSlug;
                            <a href="/Manual/@Model.book.szKey/@c.szSlug"
                               class="list-group-item list-group-item-action @(isActive ? "active" : "")"
                               aria-current="@(isActive ? "page" : null)">@c.GetTitle(isEn)</a>
                        }
                    </div>
                </div>
            </div>
        </nav>

        <!-- 中：內文 -->
        <div class="col-12 col-lg-9 col-xl-7 col-xxl-8">
            @if (Model.isLanguageFallback)
            {
                <div class="alert alert-info py-2 small manual-noprint"><i class="fas fa-language me-1"></i>@Localizer["manual.lang_fallback"]</div>
            }
            <div class="card shadow-sm">
                <div class="card-body p-3 p-md-4">
                    @if (string.IsNullOrWhiteSpace(Model.szContentHtml))
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-inbox fa-3x mb-2 d-block"></i>
                            <div>@Localizer["manual.empty_chapter"]</div>
                        </div>
                    }
                    else
                    {
                        <article class="manual-content" id="manualContent">@Html.Raw(Model.szContentHtml)</article>
                    }
                </div>
                <div class="card-footer bg-light d-flex justify-content-between gap-2 manual-noprint">
                    <div>
                        @if (Model.prev != null)
                        {
                            <a class="btn btn-sm btn-outline-primary" href="/Manual/@Model.book.szKey/@Model.prev.szSlug">
                                <i class="fas fa-chevron-left me-1"></i>@Model.prev.GetTitle(isEn)
                            </a>
                        }
                    </div>
                    <div>
                        @if (Model.next != null)
                        {
                            <a class="btn btn-sm btn-outline-primary" href="/Manual/@Model.book.szKey/@Model.next.szSlug">
                                @Model.next.GetTitle(isEn)<i class="fas fa-chevron-right ms-1"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 右：本頁目錄（manual.js 依內文 h2 / h3 產生，寬螢幕才顯示） -->
        <aside class="d-none d-xl-block col-xl-2 manual-noprint">
            <div class="manual-onpage" id="manualOnPage" hidden>
                <div class="manual-onpage-title">@Localizer["manual.on_this_page"]</div>
                <ul class="manual-onpage-list" id="manualOnPageList"></ul>
            </div>
        </aside>
    </div>
</div>

<link rel="stylesheet" href="~/css/manual.css" asp-append-version="true" />

@section Scripts {
    <script src="~/js/manual.js" asp-append-version="true"></script>
}
