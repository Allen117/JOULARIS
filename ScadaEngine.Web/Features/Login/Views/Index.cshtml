@model ScadaEngine.Web.Features.Login.Models.LoginModel
@{
    ViewData["Title"] = "系統登入";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="login-shell">
    <!-- 品牌區：JOULARIS Logo 圖 + 副標 -->
    <div class="login-brand">
        <h1 class="login-brand-title">
            <img src="~/images/joularis-logo.png"
                 alt="JOULARIS 智慧能源管理平台"
                 class="login-brand-logo"
                 asp-append-version="true" />
        </h1>
        <div class="login-brand-subtitle">智慧能源管理平台</div>
    </div>

    <div class="card login-card">
        <div class="card-body">
            <!-- 登入標題 + 提示句：明確告知此處輸入帳號密碼 -->
            <div class="login-title-block">
                <h2 class="login-title fs-3">系統登入</h2>
                <p class="login-title-hint">請輸入帳號與密碼</p>
            </div>

            @if (ViewData["SetupHint"] as bool? == true)
            {
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle"></i>
                    系統尚無管理者（Admin / Engineer）帳號，請於伺服器本機開啟
                    <strong>http://localhost:5038</strong> 完成初始設定。
                </div>
            }

            <form asp-action="Index" asp-controller="Login" method="post" id="frmLogin">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger" role="alert">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <!-- 使用者名稱輸入框 -->
                <div class="mb-3">
                    <label asp-for="szUserName" class="form-label">
                        <i class="fas fa-user"></i>
                        使用者名稱
                    </label>
                    <input asp-for="szUserName"
                           class="form-control"
                           id="tbUserName"
                           placeholder="請輸入使用者名稱"
                           autocomplete="username"
                           required />
                    <span asp-validation-for="szUserName" class="text-danger"></span>
                </div>

                <!-- 密碼輸入框 -->
                <div class="mb-3">
                    <label asp-for="szPassword" class="form-label">
                        <i class="fas fa-key"></i>
                        密碼
                    </label>
                    <input asp-for="szPassword"
                           type="password"
                           class="form-control"
                           id="tbPassword"
                           placeholder="請輸入密碼"
                           autocomplete="current-password"
                           required />
                    <span asp-validation-for="szPassword" class="text-danger"></span>
                </div>

                <!-- 記住我選項 -->
                <div class="mb-3 form-check">
                    <input asp-for="isRememberMe"
                           type="checkbox"
                           class="form-check-input"
                           id="chkRememberMe" />
                    <label asp-for="isRememberMe" class="form-check-label">
                        記住我
                    </label>
                </div>

                <!-- 登入按鈕 -->
                <div class="d-grid">
                    <button type="submit"
                            class="btn btn-primary btn-lg btn-login"
                            id="btnLogin">
                        <i class="fas fa-sign-in-alt"></i>
                        立即登入
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}
