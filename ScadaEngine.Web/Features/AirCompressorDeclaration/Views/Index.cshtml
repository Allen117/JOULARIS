@model ScadaEngine.Web.Features.AirCompressorDeclaration.Models.AirCompressorDeclarationViewModel
@{
    ViewData["Title"] = Localizer["airdeclaration.title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="mb-0">
            @* 圖示與「報表查詢 → 空壓機能源申報」選單一致（fa-wind） *@
            <i class="fas fa-wind text-primary me-2"></i>@Localizer["airdeclaration.title"]
        </h2>
    </div>

    <!-- 申報報表設定 -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <span><i class="fas fa-list-ul me-1"></i>@Localizer["airdeclaration.config.title"]</span>
            <button class="btn btn-primary btn-sm" onclick="window._acd.openCreateModal()">
                <i class="fas fa-plus me-1"></i>@Localizer["airdeclaration.button.add"]
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 acd-config-table">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["airdeclaration.config.col_name"]</th>
                            <th>@Localizer["airdeclaration.config.col_energy_circuit"]</th>
                            <th>@Localizer["airdeclaration.config.col_air_circuit"]</th>
                            <th>@Localizer["airdeclaration.config.col_description"]</th>
                            <th class="text-end">@Localizer["airdeclaration.config.col_actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="acdConfigBody">
                        <tr><td colspan="5" class="text-center text-muted py-3">@Localizer["airdeclaration.config.loading"]</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 查詢條件 -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light py-2">
            <i class="fas fa-filter me-1"></i>@Localizer["airdeclaration.filter.title"]
        </div>
        <div class="card-body p-3">
            <div class="acd-filter-bar">
                <div class="acd-report">
                    <label class="form-label fw-semibold"><i class="fas fa-wind me-1"></i>@Localizer["airdeclaration.filter.report"]</label>
                    <select id="acdReport" class="form-select form-select-sm">
                        <option value="">@Localizer["airdeclaration.select.loading"]</option>
                    </select>
                </div>
                <!-- 頁面固定格式：只選年度，產出該年 1~12 月（每月 1 號 ~ 月底） -->
                <div class="acd-narrow-date">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-alt me-1"></i>@Localizer["airdeclaration.filter.year"]</label>
                    <input type="number" id="acdYear" class="form-control form-control-sm" min="2000" max="2100"
                           data-default-year="@Model.dtToday.Year">
                </div>

                <div class="acd-btn">
                    <button class="btn btn-primary btn-sm" onclick="window._acd.query()">
                        <i class="fas fa-search me-1"></i>@Localizer["airdeclaration.button.query"]
                    </button>
                </div>
                <div class="acd-btn">
                    <button class="btn btn-success btn-sm" onclick="window._acd.exportExcel()" id="btnAcdExport" disabled>
                        <i class="fas fa-file-excel me-1"></i>@Localizer["airdeclaration.button.export"]
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 結果區 -->
    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-chart-bar me-1"></i>@Localizer["airdeclaration.chart.title"]</span>
                    <span class="ui-warn-text small" id="acdWarnText" hidden></span>
                </div>
                <div class="card-body">
                    <div style="height:360px;">
                        <canvas id="acdChart"></canvas>
                    </div>
                </div>
                <div class="card-footer bg-light text-muted small">
                    @Localizer["airdeclaration.label.total_kwh"]：<span id="acdTotalKwh" class="fw-bold text-primary">--</span> kWh
                    <span class="mx-2">|</span>
                    @Localizer["airdeclaration.label.total_nm3"]：<span id="acdTotalNm3" class="fw-bold text-primary">--</span> Nm³
                    <span class="mx-2">|</span>
                    @Localizer["airdeclaration.label.total_specific_energy"]：<span id="acdTotalEff" class="fw-bold text-primary">--</span> kWh/Nm³
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header bg-light py-2">
                    <i class="fas fa-table me-1"></i>@Localizer["airdeclaration.table.title"]
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height:420px;overflow-y:auto;">
                        <table class="table table-striped table-hover table-bordered mb-0">
                            <thead class="table-dark" style="position:sticky;top:0;z-index:30;">
                                <tr>
                                    <th>@Localizer["airdeclaration.table.col_period"]</th>
                                    <th class="text-end">@Localizer["airdeclaration.table.col_kwh"]</th>
                                    <th class="text-end">@Localizer["airdeclaration.table.col_nm3"]</th>
                                    <th class="text-end">@Localizer["airdeclaration.table.col_specific_energy"]</th>
                                </tr>
                            </thead>
                            <tbody id="acdTableBody">
                                <tr><td colspan="4" class="text-center text-muted py-4">@Localizer["airdeclaration.table.empty"]</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 新增/編輯申報報表 Modal -->
<div class="modal fade" id="acdConfigModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="acdModalTitle">@Localizer["airdeclaration.modal.title_add"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">@Localizer["airdeclaration.modal.name"] <span class="text-danger">*</span></label>
                    <input type="text" id="acdModalName" class="form-control form-control-sm" maxlength="100" autocomplete="off">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold"><i class="fas fa-bolt me-1"></i>@Localizer["airdeclaration.modal.energy_circuit"] <span class="text-danger">*</span></label>
                    <select id="acdModalEnergyCircuit" class="form-select form-select-sm"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold"><i class="fas fa-wind me-1"></i>@Localizer["airdeclaration.modal.air_circuit"] <span class="text-danger">*</span></label>
                    <select id="acdModalAirCircuit" class="form-select form-select-sm"></select>
                    <small class="text-muted d-block mt-1">@Localizer["airdeclaration.modal.air_circuit_hint"]</small>
                </div>
                <div class="mb-1">
                    <label class="form-label fw-semibold">@Localizer["airdeclaration.modal.description"]</label>
                    <textarea id="acdModalDescription" class="form-control form-control-sm" rows="2" maxlength="500"></textarea>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@Localizer["airdeclaration.modal.cancel"]</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="window._acd.saveConfig()">
                    <i class="fas fa-save me-1"></i>@Localizer["airdeclaration.modal.save"]
                </button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/aircompressordeclaration.css" asp-append-version="true" />

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/common/chart-defaults.js" asp-append-version="true"></script>
    <script src="~/js/aircompressordeclaration.js" asp-append-version="true"></script>
}
