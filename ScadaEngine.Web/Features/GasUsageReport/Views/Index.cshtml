@model ScadaEngine.Web.Features.GasUsageReport.Models.GasUsageReportViewModel
@{
    ViewData["Title"] = Localizer["gasusagereport.title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="mb-0">
            <i class="fas fa-chart-bar text-primary me-2"></i>@Localizer["gasusagereport.title"]
        </h2>
    </div>

    <!-- 查詢條件 -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light py-2">
            <i class="fas fa-filter me-1"></i>@Localizer["gasusagereport.filter.title"]
        </div>
        <div class="card-body p-3">
            <div class="gur-filter-bar">
                <div class="gur-circuit">
                    <label class="form-label fw-semibold"><i class="fas fa-sitemap me-1"></i>@Localizer["gasusagereport.filter.circuit"]</label>
                    <select id="gurCircuit" class="form-select form-select-sm">
                        <option value="">@Localizer["gasusagereport.select.loading"]</option>
                    </select>
                </div>
                <div class="gur-narrow-unit">
                    <label class="form-label fw-semibold"><i class="fas fa-clock me-1"></i>@Localizer["gasusagereport.filter.granularity"]</label>
                    <select id="gurGranularity" class="form-select form-select-sm">
                        <option value="hour">@Localizer["gasusagereport.granularity.hour"]</option>
                        <option value="day" selected>@Localizer["gasusagereport.granularity.day"]</option>
                        <option value="month">@Localizer["gasusagereport.granularity.month"]</option>
                        <option value="year">@Localizer["gasusagereport.granularity.year"]</option>
                        <option value="shift">@Localizer["gasusagereport.granularity.shift"]</option>
                    </select>
                </div>

                <!-- 時粒度：起訖時（日期 + 0~23 時，無分鐘） -->
                <div class="gur-wide-date gur-period gur-period-hour">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-day me-1"></i>@Localizer["gasusagereport.filter.hour_start"]</label>
                    <div class="input-group input-group-sm gur-hour-group">
                        <input type="date" id="gurHourStartDate" class="form-control form-control-sm">
                        <select id="gurHourStartHour" class="form-select form-select-sm gur-hour-select"></select>
                    </div>
                </div>
                <div class="gur-wide-date gur-period gur-period-hour">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-day me-1"></i>@Localizer["gasusagereport.filter.hour_end"]</label>
                    <div class="input-group input-group-sm gur-hour-group">
                        <input type="date" id="gurHourEndDate" class="form-control form-control-sm">
                        <select id="gurHourEndHour" class="form-select form-select-sm gur-hour-select"></select>
                    </div>
                </div>

                <!-- 日粒度：起訖日 -->
                <div class="gur-narrow-date gur-period gur-period-day">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar me-1"></i>@Localizer["gasusagereport.filter.day_start"]</label>
                    <input type="date" id="gurDayStart" class="form-control form-control-sm">
                </div>
                <div class="gur-narrow-date gur-period gur-period-day">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar me-1"></i>@Localizer["gasusagereport.filter.day_end"]</label>
                    <input type="date" id="gurDayEnd" class="form-control form-control-sm">
                </div>

                <!-- 月粒度：起訖月（走氣費期別，已刪除期別不產生 bucket） -->
                <div class="gur-narrow-date gur-period gur-period-month">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-week me-1"></i>@Localizer["gasusagereport.filter.month_start"]</label>
                    <input type="month" id="gurMonthStart" class="form-control form-control-sm">
                </div>
                <div class="gur-narrow-date gur-period gur-period-month">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-week me-1"></i>@Localizer["gasusagereport.filter.month_end"]</label>
                    <input type="month" id="gurMonthEnd" class="form-control form-control-sm">
                </div>

                <!-- 年粒度：起訖年 -->
                <div class="gur-narrow-date gur-period gur-period-year">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-alt me-1"></i>@Localizer["gasusagereport.filter.year_start"]</label>
                    <input type="number" id="gurYearStart" class="form-control form-control-sm" min="2000" max="2100">
                </div>
                <div class="gur-narrow-date gur-period gur-period-year">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-alt me-1"></i>@Localizer["gasusagereport.filter.year_end"]</label>
                    <input type="number" id="gurYearEnd" class="form-control form-control-sm" min="2000" max="2100">
                </div>

                <!-- 班別粒度：起訖日（每列 = 日期 × 班別；班別於 /ShiftSetting 定義） -->
                <div class="gur-narrow-date gur-period gur-period-shift">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar me-1"></i>@Localizer["gasusagereport.filter.day_start"]</label>
                    <input type="date" id="gurShiftStart" class="form-control form-control-sm">
                </div>
                <div class="gur-narrow-date gur-period gur-period-shift">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar me-1"></i>@Localizer["gasusagereport.filter.day_end"]</label>
                    <input type="date" id="gurShiftEnd" class="form-control form-control-sm">
                </div>

                <!-- 月粒度：期別實際區間提示（由 /GasBillingPeriodSetting/api/range 帶出） -->
                <div class="gur-period gur-period-month gur-period-hint">
                    <span id="gurPeriodHint" class="text-muted small"></span>
                </div>

                <div class="gur-btn">
                    <button class="btn btn-primary btn-sm" onclick="window._gur.query()">
                        <i class="fas fa-search me-1"></i>@Localizer["gasusagereport.button.query"]
                    </button>
                </div>
                <div class="gur-btn">
                    <button class="btn btn-success btn-sm" onclick="window._gur.exportExcel()" id="btnGurExport" disabled>
                        <i class="fas fa-file-excel me-1"></i>@Localizer["gasusagereport.button.export"]
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 結果區 -->
    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-chart-bar me-1"></i>@Localizer["gasusagereport.chart.title"]</span>
                    <div class="d-flex align-items-center gap-2">
                        <span class="ui-warn-text small" id="gurWarnText" hidden></span>
                        <button type="button" id="btnGurToggleBreakdown" class="btn btn-sm btn-outline-secondary d-none" onclick="window._gur.toggleBreakdown()">
                            <i class="fas fa-layer-group me-1"></i><span id="btnGurToggleBreakdownText">@Localizer["gasusagereport.button.show_breakdown"]</span>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div style="height:360px;">
                        <canvas id="gurChart"></canvas>
                    </div>
                </div>
                <div class="card-footer bg-light text-muted small">
                    @Localizer["gasusagereport.label.total"]：<span id="gurTotal" class="fw-bold text-primary">--</span> m&#179;
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header bg-light py-2">
                    <i class="fas fa-table me-1"></i>@Localizer["gasusagereport.table.title"]
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height:420px;overflow-y:auto;">
                        <table class="table table-striped table-hover table-bordered mb-0">
                            <thead class="table-dark" style="position:sticky;top:0;z-index:30;">
                                <tr>
                                    <th>@Localizer["gasusagereport.table.col_period"]</th>
                                    <th class="text-end">@Localizer["gasusagereport.table.col_m3"]</th>
                                </tr>
                            </thead>
                            <tbody id="gurTableBody">
                                <tr><td colspan="2" class="text-center text-muted py-4">@Localizer["gasusagereport.table.empty"]</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/gasusagereport.css" asp-append-version="true" />

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/common/chart-defaults.js" asp-append-version="true"></script>
    <script src="~/js/gasusagereport.js" asp-append-version="true"></script>
    <script>
        window._gurInit = { today: '@Model.dtToday.ToString("yyyy-MM-dd")' };
    </script>
}
