@model ScadaEngine.Web.Features.ContractCapacity.Models.ContractCapacityViewModel
@{
    ViewData["Title"] = Localizer["contractcapacity.title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-2">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <h2 class="mb-0">
            <i class="fas fa-sliders-h text-primary me-2"></i>@Localizer["contractcapacity.title"]
        </h2>
        <span class="text-muted small" id="ccPlanInfo"></span>
    </div>

    <!-- 回測條件 -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light py-2">
            <i class="fas fa-filter me-1"></i>@Localizer["contractcapacity.filter.title"]
        </div>
        <div class="card-body p-3">
            <div class="cc-filter-bar">
                <div>
                    <label class="form-label fw-semibold" for="ccCircuit"><i class="fas fa-plug me-1"></i>@Localizer["contractcapacity.filter.circuit"]</label>
                    <select id="ccCircuit" class="form-select form-select-sm"></select>
                </div>
                <div>
                    <label class="form-label fw-semibold" for="ccFrom"><i class="fas fa-calendar-alt me-1"></i>@Localizer["contractcapacity.filter.from"]</label>
                    <input type="month" id="ccFrom" class="form-control form-control-sm">
                </div>
                <div>
                    <label class="form-label fw-semibold" for="ccTo">@Localizer["contractcapacity.filter.to"]</label>
                    <input type="month" id="ccTo" class="form-control form-control-sm">
                </div>
                <div>
                    <label class="form-label fw-semibold" for="ccRound"><i class="fas fa-ruler-horizontal me-1"></i>@Localizer["contractcapacity.filter.round"]</label>
                    <select id="ccRound" class="form-select form-select-sm">
                        <option value="1">1 kW</option>
                        <option value="5">5 kW</option>
                        <option value="10" selected>10 kW</option>
                        <option value="50">50 kW</option>
                        <option value="100">100 kW</option>
                    </select>
                </div>
                <div class="cc-narrow">
                    <label class="form-label fw-semibold" for="ccThreshold" title="@Localizer["contractcapacity.filter.threshold_hint"]">@Localizer["contractcapacity.filter.threshold"]</label>
                    <input type="number" id="ccThreshold" class="form-control form-control-sm text-end" value="95" min="0" max="100" step="1">
                </div>
                <div class="cc-narrow">
                    <label class="form-label fw-semibold" for="ccMaxValid" title="@Localizer["contractcapacity.filter.max_valid_hint"]">@Localizer["contractcapacity.filter.max_valid"]</label>
                    <input type="number" id="ccMaxValid" class="form-control form-control-sm text-end" min="0" step="1" placeholder="@Localizer["contractcapacity.filter.max_valid_placeholder"]">
                </div>
                <div class="cc-btn">
                    <button class="btn btn-primary btn-sm" id="ccBtnRun" onclick="window._cc.run()">
                        <i class="fas fa-calculator me-1"></i>@Localizer["contractcapacity.button.run"]
                    </button>
                </div>
                <div class="cc-btn">
                    <button class="btn btn-success btn-sm" id="ccBtnExport" onclick="window._cc.exportExcel()" disabled>
                        <i class="fas fa-file-excel me-1"></i>@Localizer["contractcapacity.button.export"]
                    </button>
                </div>
            </div>
            <div class="text-muted small mt-2">
                <i class="fas fa-info-circle me-1"></i>@Localizer["contractcapacity.filter.hint"]
                <a href="/TariffSetting" class="ms-1">@Localizer["contractcapacity.filter.tariff_link"]</a>
            </div>
        </div>
    </div>

    <div id="ccMessage"></div>

    <div id="ccResult" class="d-none">
        <!-- KPI -->
        <div class="row g-3 mb-3">
            <div class="col-md-6 col-xl-3">
                <div class="card shadow-sm cc-kpi cc-cur h-100"><div class="card-body">
                    <div class="cc-kpi-label"><i class="fas fa-file-contract me-1"></i>@Localizer["contractcapacity.kpi.current"]</div>
                    <div class="cc-kpi-main" id="kpiCurCost">--</div>
                    <div class="cc-kpi-sub text-muted" id="kpiCurSub">--</div>
                </div></div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="card shadow-sm cc-kpi cc-safe h-100"><div class="card-body">
                    <div class="cc-kpi-label"><i class="fas fa-shield-alt me-1"></i>@Localizer["contractcapacity.kpi.safe"]</div>
                    <div class="cc-kpi-main" id="kpiSafeC">--</div>
                    <div class="cc-kpi-sub" id="kpiSafeSub">--</div>
                </div></div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="card shadow-sm cc-kpi cc-min h-100"><div class="card-body">
                    <div class="cc-kpi-label"><i class="fas fa-bullseye me-1"></i>@Localizer["contractcapacity.kpi.optimum"]</div>
                    <div class="cc-kpi-main" id="kpiMinC">--</div>
                    <div class="cc-kpi-sub" id="kpiMinSub">--</div>
                </div></div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="card shadow-sm cc-kpi cc-dq h-100"><div class="card-body">
                    <div class="cc-kpi-label"><i class="fas fa-check-circle me-1"></i>@Localizer["contractcapacity.kpi.quality"]</div>
                    <div class="cc-kpi-main" id="kpiDq">--</div>
                    <div class="cc-kpi-sub text-muted" id="kpiDqSub">--</div>
                </div></div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center flex-wrap gap-1">
                        <span><i class="fas fa-chart-area me-1"></i>@Localizer["contractcapacity.chart.curve"]</span>
                        <span class="text-muted small" id="ccFlatNote"></span>
                    </div>
                    <div class="card-body"><div class="cc-chart-box"><canvas id="ccCurve"></canvas></div></div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-light py-2">
                        <i class="fas fa-chart-bar me-1"></i>@Localizer["contractcapacity.chart.monthly"]
                    </div>
                    <div class="card-body"><div class="cc-chart-box"><canvas id="ccMonthly"></canvas></div></div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center flex-wrap gap-1">
                <span><i class="fas fa-table me-1"></i>@Localizer["contractcapacity.table.title"]</span>
                <span class="text-muted small">@Localizer["contractcapacity.table.rule"]</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-bordered mb-0 cc-table">
                        <thead class="table-dark">
                            <tr>
                                <th rowspan="2" class="align-middle">@Localizer["contractcapacity.table.month"]</th>
                                <th rowspan="2" class="align-middle text-end">@Localizer["contractcapacity.table.price"]</th>
                                <th rowspan="2" class="align-middle text-end">@Localizer["contractcapacity.table.max_demand"]</th>
                                <th rowspan="2" class="align-middle">@Localizer["contractcapacity.table.peak_at"]</th>
                                <th rowspan="2" class="align-middle text-end">@Localizer["contractcapacity.table.completeness"]</th>
                                <th colspan="2" class="text-center" id="thCur">@Localizer["contractcapacity.scenario.current"]</th>
                                <th colspan="2" class="text-center" id="thSafe">@Localizer["contractcapacity.scenario.safe"]</th>
                                <th colspan="2" class="text-center" id="thMin">@Localizer["contractcapacity.scenario.optimum"]</th>
                            </tr>
                            <tr>
                                <th class="text-end">@Localizer["contractcapacity.table.over_kw"]</th><th class="text-end">@Localizer["contractcapacity.table.cost"]</th>
                                <th class="text-end">@Localizer["contractcapacity.table.over_kw"]</th><th class="text-end">@Localizer["contractcapacity.table.cost"]</th>
                                <th class="text-end">@Localizer["contractcapacity.table.over_kw"]</th><th class="text-end">@Localizer["contractcapacity.table.cost"]</th>
                            </tr>
                        </thead>
                        <tbody id="ccBody"></tbody>
                        <tfoot id="ccFoot"></tfoot>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light text-muted small">
                <div><i class="fas fa-info-circle me-1"></i>@Localizer["contractcapacity.note.backtest"]</div>
                <div class="mt-1"><i class="fas fa-exclamation-triangle me-1"></i>@Localizer["contractcapacity.note.scope"]</div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/contractcapacity.css" asp-append-version="true" />

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/common/chart-defaults.js" asp-append-version="true"></script>
    <script src="~/js/contractcapacity.js" asp-append-version="true"></script>
}
