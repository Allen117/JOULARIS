@model ScadaEngine.Web.Features.WaterUsageReport.Models.WaterUsageReportViewModel
@{
    ViewData["Title"] = Localizer["waterusagereport.title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="mb-0">
            <i class="fas fa-chart-bar text-primary me-2"></i>@Localizer["waterusagereport.title"]
        </h2>
    </div>

    <!-- 查詢條件 -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light py-2">
            <i class="fas fa-filter me-1"></i>@Localizer["waterusagereport.filter.title"]
        </div>
        <div class="card-body p-3">
            <div class="wur-filter-bar">
                <div class="wur-circuit">
                    <label class="form-label fw-semibold"><i class="fas fa-sitemap me-1"></i>@Localizer["waterusagereport.filter.circuit"]</label>
                    <select id="wurCircuit" class="form-select form-select-sm">
                        <option value="">@Localizer["waterusagereport.select.loading"]</option>
                    </select>
                </div>
                <div class="wur-narrow-unit">
                    <label class="form-label fw-semibold"><i class="fas fa-clock me-1"></i>@Localizer["waterusagereport.filter.granularity"]</label>
                    <select id="wurGranularity" class="form-select form-select-sm">
                        <option value="hour">@Localizer["waterusagereport.granularity.hour"]</option>
                        <option value="day" selected>@Localizer["waterusagereport.granularity.day"]</option>
                        <option value="month">@Localizer["waterusagereport.granularity.month"]</option>
                        <option value="year">@Localizer["waterusagereport.granularity.year"]</option>
                        <option value="shift">@Localizer["waterusagereport.granularity.shift"]</option>
                    </select>
                </div>

                <!-- 時粒度：起訖時（日期 + 0~23 時，無分鐘） -->
                <div class="wur-wide-date wur-period wur-period-hour">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-day me-1"></i>@Localizer["waterusagereport.filter.hour_start"]</label>
                    <div class="input-group input-group-sm wur-hour-group">
                        <input type="date" id="wurHourStartDate" class="form-control form-control-sm">
                        <select id="wurHourStartHour" class="form-select form-select-sm wur-hour-select"></select>
                    </div>
                </div>
                <div class="wur-wide-date wur-period wur-period-hour">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-day me-1"></i>@Localizer["waterusagereport.filter.hour_end"]</label>
                    <div class="input-group input-group-sm wur-hour-group">
                        <input type="date" id="wurHourEndDate" class="form-control form-control-sm">
                        <select id="wurHourEndHour" class="form-select form-select-sm wur-hour-select"></select>
                    </div>
                </div>

                <!-- 日粒度：起訖日 -->
                <div class="wur-narrow-date wur-period wur-period-day">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar me-1"></i>@Localizer["waterusagereport.filter.day_start"]</label>
                    <input type="date" id="wurDayStart" class="form-control form-control-sm">
                </div>
                <div class="wur-narrow-date wur-period wur-period-day">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar me-1"></i>@Localizer["waterusagereport.filter.day_end"]</label>
                    <input type="date" id="wurDayEnd" class="form-control form-control-sm">
                </div>

                <!-- 月粒度：起訖月 -->
                <div class="wur-narrow-date wur-period wur-period-month">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-week me-1"></i>@Localizer["waterusagereport.filter.month_start"]</label>
                    <input type="month" id="wurMonthStart" class="form-control form-control-sm">
                </div>
                <div class="wur-narrow-date wur-period wur-period-month">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-week me-1"></i>@Localizer["waterusagereport.filter.month_end"]</label>
                    <input type="month" id="wurMonthEnd" class="form-control form-control-sm">
                </div>

                <!-- 年粒度：起訖年 -->
                <div class="wur-narrow-date wur-period wur-period-year">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-alt me-1"></i>@Localizer["waterusagereport.filter.year_start"]</label>
                    <input type="number" id="wurYearStart" class="form-control form-control-sm" min="2000" max="2100">
                </div>
                <div class="wur-narrow-date wur-period wur-period-year">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-alt me-1"></i>@Localizer["waterusagereport.filter.year_end"]</label>
                    <input type="number" id="wurYearEnd" class="form-control form-control-sm" min="2000" max="2100">
                </div>

                <!-- 班別粒度：起訖日（每列 = 日期 × 班別；班別於 /ShiftSetting 定義） -->
                <div class="wur-narrow-date wur-period wur-period-shift">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar me-1"></i>@Localizer["waterusagereport.filter.day_start"]</label>
                    <input type="date" id="wurShiftStart" class="form-control form-control-sm">
                </div>
                <div class="wur-narrow-date wur-period wur-period-shift">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar me-1"></i>@Localizer["waterusagereport.filter.day_end"]</label>
                    <input type="date" id="wurShiftEnd" class="form-control form-control-sm">
                </div>

                <!-- 月粒度：期別實際區間提示（由 /BillingPeriodSetting/api/range 帶出） -->
                <div class="wur-period wur-period-month wur-period-hint">
                    <span id="wurPeriodHint" class="text-muted small"></span>
                </div>

                <div class="wur-btn">
                    <button class="btn btn-primary btn-sm" onclick="window._wur.query()">
                        <i class="fas fa-search me-1"></i>@Localizer["waterusagereport.button.query"]
                    </button>
                </div>
                <div class="wur-btn">
                    <button class="btn btn-success btn-sm" onclick="window._wur.exportExcel()" id="btnExport" disabled>
                        <i class="fas fa-file-excel me-1"></i>@Localizer["waterusagereport.button.export"]
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 結果區 -->
    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-chart-bar me-1"></i>@Localizer["waterusagereport.chart.title"]</span>
                    <div class="d-flex align-items-center gap-2">
                        <span class="ui-warn-text small" id="wurWarnText" hidden></span>
                        <button type="button" id="btnToggleBreakdown" class="btn btn-sm btn-outline-secondary d-none" onclick="window._wur.toggleBreakdown()">
                            <i class="fas fa-layer-group me-1"></i><span id="btnToggleBreakdownText">@Localizer["waterusagereport.button.show_breakdown"]</span>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div style="height:360px;">
                        <canvas id="wurChart"></canvas>
                    </div>
                </div>
                <div class="card-footer bg-light text-muted small">
                    @Localizer["waterusagereport.label.total"]：<span id="wurTotal" class="fw-bold text-primary">--</span> m³
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header bg-light py-2">
                    <i class="fas fa-table me-1"></i>@Localizer["waterusagereport.table.title"]
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height:420px;overflow-y:auto;">
                        <table class="table table-striped table-hover table-bordered mb-0">
                            <thead class="table-dark" style="position:sticky;top:0;z-index:30;">
                                <tr>
                                    <th>@Localizer["waterusagereport.table.col_period"]</th>
                                    <th class="text-end">@Localizer["waterusagereport.table.col_m3"]</th>
                                </tr>
                            </thead>
                            <tbody id="wurTableBody">
                                <tr><td colspan="2" class="text-center text-muted py-4">@Localizer["waterusagereport.table.empty"]</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/waterusagereport.css" />

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/common/chart-defaults.js" asp-append-version="true"></script>
    <script src="~/js/waterusagereport.js"></script>
    <script>
        window._wurInit = { today: '@Model.dtToday.ToString("yyyy-MM-dd")' };
    </script>
}
